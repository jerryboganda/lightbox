---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import App from '../layouts/App.astro';
import Icon from '../components/Icon.astro';
import { images, shortFile } from '../lib/data';

const mods = import.meta.glob<{ default: ImageMetadata }>('/src/assets/atlas/*', { eager: true });
const byName = new Map(Object.entries(mods).map(([p, m]) => [p.split('/').pop()!, m.default]));
const items = await Promise.all(images.filter((im) => byName.has(im.file)).map(async (im) => {
  const src = byName.get(im.file)!;
  const [thumb, full] = await Promise.all([
    getImage({ src, width: Math.min(560, src.width), format: 'webp', quality: 72 }),
    getImage({ src, width: Math.min(1800, src.width), format: 'webp', quality: 82 }),
  ]);
  const lines = im.caption.split('\n').map((l) => l.trim()).filter(Boolean);
  return { ...im, thumb: thumb.src, full: full.src, w: full.attributes.width ?? src.width, h: full.attributes.height ?? src.height, tw: src.width, th: src.height, title: lines[0] || 'No source caption', group: shortFile(im.sourceFile).replace(/^WhatsApp Image .*/, 'WhatsApp images') };
}));
const groups = [...new Set(items.map((i) => i.group))];
---
<App title="Atlas" wide>
  <header class="reveal flex flex-col gap-3 md:flex-row md:items-end md:justify-between" style="--i:0">
    <div>
      <h1 class="text-2xl font-medium">Image atlas</h1>
      <p class="mt-1 max-w-2xl text-muted">{items.length} images from the papers and slides, each with its source caption copied exactly. Lightbox adds no diagnosis.</p>
    </div>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by source" data-groups>
      <button type="button" class="chip" aria-pressed="true" data-g="">All <span class="num text-muted">{items.length}</span></button>
      {groups.map((g) => <button type="button" class="chip" aria-pressed="false" data-g={g}>{g} <span class="num text-muted">{items.filter((i) => i.group === g).length}</span></button>)}
    </div>
  </header>

  <div id="atlas" class="masonry mt-6">
    {items.map((im, i) => (
      <a href={im.full} data-pswp-width={im.w} data-pswp-height={im.h} data-group={im.group} data-file={im.file} class="tile reveal group" style={`--i:${Math.min(i, 16)}`} target="_blank">
        <img src={im.thumb} alt={im.title} width={im.tw} height={im.th} loading={i < 8 ? 'eager' : 'lazy'} decoding="async" />
        <span class="cap"><span class="line-clamp-2 text-sm text-white">{im.title}</span><span class="mt-0.5 block truncate text-[11px] text-white/65">{shortFile(im.sourceFile)}{im.page ? ` · p${im.page}` : ''}</span></span>
        <span class="hidden" data-caption>{im.caption}</span>
        <span class="hidden" data-source>{im.sourceFile}{im.page ? ` · page or slide ${im.page}` : ''}</span>
      </a>
    ))}
  </div>
  <p class="mt-8 flex items-center gap-2 text-xs text-faint"><Icon name="Info" size={14} />Captions are verbatim from the source files, including their own wording and errors. Unclear captions are flagged in the review centre.</p>
</App>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';
  let lb: PhotoSwipeLightbox | null = null;
  function init() {
    const root = document.getElementById('atlas');
    if (!root) return;
    lb?.destroy();
    lb = new PhotoSwipeLightbox({ gallery: '#atlas', children: 'a.tile:not(.off)', pswpModule: () => import('photoswipe'), bgOpacity: 0.92, wheelToZoom: true, showHideAnimationType: 'zoom' });
    lb.on('uiRegister', () => {
      lb!.pswp!.ui!.registerElement({
        name: 'lb-caption', order: 9, isButton: false, appendTo: 'root',
        onInit: (el, pswp) => {
          el.className = 'pswp-cap';
          pswp.on('change', () => {
            const a = pswp.currSlide?.data.element as HTMLElement | undefined;
            el.innerHTML = '';
            if (!a) return;
            const p = document.createElement('p'); p.textContent = a.querySelector('[data-caption]')?.textContent || 'No source caption';
            const s = document.createElement('span'); s.textContent = a.querySelector('[data-source]')?.textContent || '';
            el.append(p, s);
          });
        },
      });
    });
    lb.init();
    document.querySelectorAll<HTMLButtonElement>('[data-groups] [data-g]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-groups] [data-g]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('a.tile').forEach((a) => a.classList.toggle('off', !!b.dataset.g && a.dataset.group !== b.dataset.g));
    }));
    const want = new URLSearchParams(location.search).get('img');
    if (want) {
      const list = [...root.querySelectorAll<HTMLElement>('a.tile')];
      const k = list.findIndex((a) => a.dataset.file === want);
      if (k >= 0) lb.loadAndOpen(k);
    }
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style is:global>
  .masonry { columns: 4 15rem; column-gap: 1rem; }
  .masonry .tile { position: relative; display: block; margin-bottom: 1rem; break-inside: avoid; overflow: hidden; border-radius: 14px; border: 1px solid var(--line); background: var(--sunk); }
  .masonry .tile.off { display: none; }
  .masonry img { display: block; width: 100%; height: auto; transition: transform var(--d4) var(--ease), filter var(--d3); }
  .masonry .tile:hover img { transform: scale(calc(1 + 0.035 * var(--move))); }
  .masonry .cap { position: absolute; inset: auto 0 0 0; padding: 2.5rem 0.85rem 0.75rem; background: linear-gradient(transparent, rgb(0 0 0 / 0.78)); opacity: 0; transform: translateY(calc(6px * var(--move))); transition: opacity var(--d2), transform var(--d2) var(--ease); }
  .masonry .tile:hover .cap, .masonry .tile:focus-visible .cap { opacity: 1; transform: none; }
  @media (hover: none) { .masonry .cap { opacity: 1; transform: none; } }
  .pswp-cap { position: absolute; left: 50%; bottom: 1.25rem; translate: -50% 0; width: min(46rem, calc(100% - 2rem)); max-height: 30vh; overflow: auto; padding: 0.85rem 1.1rem; border-radius: 14px; background: rgb(11 15 20 / 0.82); backdrop-filter: blur(10px); border: 1px solid rgb(255 255 255 / 0.08); color: #e6edf3; font-size: 0.875rem; line-height: 1.55; }
  .pswp-cap p { white-space: pre-line; }
  .pswp-cap span { display: block; margin-top: 0.4rem; font-size: 0.75rem; color: #8b98a5; }
  .pswp { --pswp-bg: #05070a; }
</style>
