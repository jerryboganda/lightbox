---
import App from '../layouts/App.astro';
import Icon from '../components/Icon.astro';
import { createUser, resetPassword, validUsername, type Role } from '../server/auth';
import { audit, db, now } from '../server/db';

const me = Astro.locals.user!;
let flash: { kind: 'ok' | 'bad'; text: string; secret?: { user: string; pw: string } } | null = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData().catch(() => new FormData());
  const action = String(f.get('action')), id = Number(f.get('id'));
  const admins = () => (db.prepare("SELECT COUNT(*) n FROM users WHERE role = 'admin' AND disabled = 0").get() as any).n as number;
  const target = id ? (db.prepare('SELECT id, username, role, disabled FROM users WHERE id = ?').get(id) as any) : null;
  try {
    if (action === 'create') {
      const username = String(f.get('username') || '').trim().toLowerCase(), name = String(f.get('displayName') || '').trim() || username;
      const role = (f.get('role') === 'admin' ? 'admin' : 'member') as Role;
      if (!validUsername(username)) flash = { kind: 'bad', text: 'Usernames are 3–32 characters: letters, numbers, dot, dash or underscore.' };
      else if (db.prepare('SELECT 1 FROM users WHERE username = ?').get(username)) flash = { kind: 'bad', text: `@${username} already exists.` };
      else flash = { kind: 'ok', text: `Created @${username}.`, secret: { user: username, pw: await createUser(me.id, username, name.slice(0, 60), role) } };
    } else if (target && action === 'reset') {
      flash = { kind: 'ok', text: `New temporary password for @${target.username}. Their other sessions were signed out.`, secret: { user: target.username, pw: await resetPassword(me.id, target.id) } };
    } else if (target && action === 'toggle') {
      if (target.id === me.id) flash = { kind: 'bad', text: "You can't disable your own account." };
      else {
        db.prepare('UPDATE users SET disabled = ? WHERE id = ?').run(target.disabled ? 0 : 1, target.id);
        if (!target.disabled) db.prepare('DELETE FROM sessions WHERE user_id = ?').run(target.id);
        audit(me.id, target.disabled ? 'user.enable' : 'user.disable', target.username);
        flash = { kind: 'ok', text: `@${target.username} ${target.disabled ? 'enabled' : 'disabled'}.` };
      }
    } else if (target && action === 'role') {
      const next = target.role === 'admin' ? 'member' : 'admin';
      if (next === 'member' && admins() <= 1) flash = { kind: 'bad', text: 'Keep at least one admin.' };
      else { db.prepare('UPDATE users SET role = ? WHERE id = ?').run(next, target.id); audit(me.id, 'user.role', `${target.username}:${next}`); flash = { kind: 'ok', text: `@${target.username} is now ${next === 'admin' ? 'an admin' : 'a member'}.` }; }
    } else if (action === 'announce') {
      const body = String(f.get('body') || '').trim().slice(0, 600);
      if (body) { db.prepare('INSERT INTO announcements (body, created_by, created_at) VALUES (?, ?, ?)').run(body, me.id, now()); audit(me.id, 'announce'); flash = { kind: 'ok', text: 'Announcement posted to everyone\'s dashboard.' }; }
    } else if (action === 'unannounce') {
      db.prepare('UPDATE announcements SET active = 0 WHERE id = ?').run(id); flash = { kind: 'ok', text: 'Announcement hidden.' };
    }
  } catch (e) { flash = { kind: 'bad', text: 'That action failed. Try again.' }; }
}

const users = db.prepare(`SELECT u.id, u.username, u.display_name, u.role, u.disabled, u.must_change, u.created_at, u.last_seen_at,
  (SELECT COUNT(*) FROM srs_log l WHERE l.user_id = u.id) reviews, (SELECT COUNT(DISTINCT qid) FROM mcq_attempts a WHERE a.user_id = u.id) answered
  FROM users u ORDER BY u.disabled, u.role, u.username`).all() as any[];
const anns = db.prepare('SELECT id, body, created_at FROM announcements WHERE active = 1 ORDER BY created_at DESC').all() as any[];
const log = db.prepare('SELECT a.action, a.target, a.at, u.username FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id ORDER BY a.id DESC LIMIT 25').all() as any[];
const ago = (t?: number) => { if (!t) return 'never'; const m = (now() - t) / 60000; return m < 2 ? 'just now' : m < 60 ? `${Math.round(m)} min ago` : m < 1440 ? `${Math.round(m / 60)} h ago` : `${Math.round(m / 1440)} d ago`; };
---
<App title="Admin">
  <header class="reveal" style="--i:0"><h1 class="text-2xl font-medium">Admin</h1><p class="mt-1 text-muted">Issue accounts, reset passwords and post announcements.</p></header>

  {flash && (
    <div role={flash.kind === 'bad' ? 'alert' : 'status'} class:list={['mt-5 rounded-xl border px-4 py-3 text-sm', flash.kind === 'ok' ? 'border-ok/30 bg-ok/10' : 'border-bad/30 bg-bad/10 text-bad']}>
      <p class={flash.kind === 'ok' ? 'text-ok' : ''}>{flash.text}</p>
      {flash.secret && (
        <div class="mt-3 flex flex-wrap items-center gap-3 rounded-lg bg-sunk px-3 py-2.5 text-ink">
          <span class="text-muted">Username</span><span class="num">{flash.secret.user}</span>
          <span class="text-muted">Temporary password</span><span class="num text-accent" data-secret>{flash.secret.pw}</span>
          <button type="button" class="btn btn-sm ml-auto" data-copy={`Lightbox login\nhttps://lightbox.polytronx.com\nUsername: ${flash.secret.user}\nTemporary password: ${flash.secret.pw}`}><Icon name="Copy" size={14} />Copy login details</button>
        </div>
      )}
      {flash.secret && <p class="mt-2 text-xs text-muted">Shown once. They'll be asked to choose their own password at first sign-in.</p>}
    </div>
  )}

  <div class="mt-6 grid gap-5 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <section class="panel overflow-hidden">
      <header class="flex items-center justify-between px-5 pt-5"><h2 class="font-medium">Users <span class="num text-faint">{users.length}</span></h2></header>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full min-w-[40rem] text-sm">
          <thead class="text-left text-xs text-faint"><tr><th class="px-5 py-2 font-normal">User</th><th class="px-3 py-2 font-normal">Role</th><th class="px-3 py-2 font-normal">Activity</th><th class="px-3 py-2 font-normal">Last seen</th><th class="px-5 py-2"></th></tr></thead>
          <tbody class="divide-y divide-line">
            {users.map((u) => (
              <tr class:list={[{ 'opacity-55': u.disabled }]}>
                <td class="px-5 py-3"><div class="font-medium">{u.display_name}</div><div class="num text-xs text-faint">@{u.username}{u.must_change ? ' · awaiting first sign-in' : ''}{u.disabled ? ' · disabled' : ''}</div></td>
                <td class="px-3 py-3"><span class:list={['badge', u.role === 'admin' ? 's-edition' : 's-neutral']}>{u.role}</span></td>
                <td class="num px-3 py-3 text-xs text-muted">{u.reviews} reviews · {u.answered} MCQs</td>
                <td class="px-3 py-3 text-xs text-muted">{ago(u.last_seen_at)}</td>
                <td class="px-5 py-3">
                  <div class="flex justify-end gap-1">
                    <form method="post"><input type="hidden" name="id" value={u.id} /><button name="action" value="reset" class="btn btn-sm btn-ghost" title="Reset password"><Icon name="KeyRound" size={15} /><span class="sr-only">Reset password</span></button></form>
                    <form method="post"><input type="hidden" name="id" value={u.id} /><button name="action" value="role" class="btn btn-sm btn-ghost" title={u.role === 'admin' ? 'Make member' : 'Make admin'}><Icon name="ShieldCheck" size={15} /><span class="sr-only">Change role</span></button></form>
                    {u.id !== me.id && <form method="post"><input type="hidden" name="id" value={u.id} /><button name="action" value="toggle" class="btn btn-sm btn-ghost" title={u.disabled ? 'Enable' : 'Disable'}><Icon name={u.disabled ? 'UserCheck' : 'UserX'} size={15} /><span class="sr-only">{u.disabled ? 'Enable' : 'Disable'}</span></button></form>}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="space-y-5">
      <section class="panel p-5">
        <h2 class="font-medium">Add a classmate</h2>
        <form method="post" class="mt-4 space-y-3">
          <input type="hidden" name="action" value="create" />
          <label class="block text-sm font-medium">Username<input class="field mt-1.5 num" name="username" required pattern="[A-Za-z0-9][A-Za-z0-9._-]{2,31}" autocapitalize="none" spellcheck="false" placeholder="ayesha.amjad" /></label>
          <label class="block text-sm font-medium">Display name<input class="field mt-1.5" name="displayName" maxlength="60" placeholder="Dr Ayesha Amjad" /></label>
          <label class="block text-sm font-medium">Role<select class="field mt-1.5" name="role"><option value="member">Member</option><option value="admin">Admin</option></select></label>
          <button class="btn btn-primary w-full justify-center"><Icon name="UserPlus" size={16} />Create account</button>
          <p class="text-xs text-faint">A temporary password is generated and shown once.</p>
        </form>
      </section>
      <section class="panel p-5">
        <h2 class="font-medium">Announcement</h2>
        <form method="post" class="mt-3 space-y-3"><input type="hidden" name="action" value="announce" /><textarea name="body" rows="3" maxlength="600" class="field !h-auto py-2" placeholder="Mock TOACS on Sunday at 10 am in the seminar room."></textarea><button class="btn w-full justify-center"><Icon name="Megaphone" size={16} />Post to dashboards</button></form>
        {anns.length > 0 && <ul class="mt-4 space-y-2">{anns.map((a) => <li class="flex items-start gap-2 rounded-lg bg-sunk px-3 py-2 text-sm"><span class="flex-1 whitespace-pre-line">{a.body}</span><form method="post"><input type="hidden" name="id" value={a.id} /><button name="action" value="unannounce" class="text-faint hover:text-bad" aria-label="Hide announcement"><Icon name="X" size={15} /></button></form></li>)}</ul>}
      </section>
      <section class="panel p-5">
        <h2 class="font-medium">Recent activity</h2>
        <ul class="mt-3 space-y-1.5 text-xs">{log.map((l) => <li class="flex gap-2"><span class="num w-20 shrink-0 text-faint">{ago(l.at)}</span><span class="text-muted"><span class="text-ink">@{l.username ?? 'system'}</span> {l.action.replace('.', ' ')} {l.target}</span></li>)}</ul>
      </section>
    </div>
  </div>
</App>
<script>
  function init() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copy!);
      const t = b.innerHTML; b.textContent = 'Copied'; setTimeout(() => (b.innerHTML = t), 1600);
    }));
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>
