---
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import Status from '../../../components/Status.astro';
import FactPop from '../../../components/FactPop.astro';
import MarkToggle from '../../../components/MarkToggle.astro';
import CollectMenu from '../../../components/islands/CollectMenu';
import ReportButton from '../../../components/islands/ReportButton';
import Thread from '../../../components/islands/Thread';
import AiGenerate from '../../../components/islands/AiGenerate';
import { cardByFact, factById, mcqs, topics, topicBySlug, SYSTEMS, LABELS } from '../../../lib/data';
import { deckStatus, factStates, noteVisit, visitPos, type FactState } from '../../../server/progress';
import { compareWith, inPlayer } from '../../../server/study';
import { mcqTopics } from '../../../server/analytics';
import { sourceHref } from '../../../lib/sources';

const { system, slug } = Astro.params;
const t = topicBySlug.get(slug!);
if (!t || t.system !== system) return Astro.redirect(`/study/${system ?? ''}`);
noteVisit(Astro.locals.user!.id, 'topic', Astro.url.pathname, t.title);

const ids = [...new Set(t.sections.flatMap((s) => s.bullets.flatMap((b) => b.ids)))];
const fs = ids.map((id) => factById.get(id)!).filter(Boolean);
const deck = deckStatus(Astro.locals.user!.id, ids);
const toLearn = deck.cards - deck.inDeck;
// Mastery: the student's own recall of each point, from their flashcards (worst card wins).
const states = factStates(Astro.locals.user!.id, ids);
const RANK: Record<FactState, number> = { lapsed: 0, learning: 1, unseen: 2, strong: 3 };
const MASTERY: Record<FactState, string> = { lapsed: 'Slipping', learning: 'Learning', unseen: 'Not learned yet', strong: 'Strong' };
const mastery = (xs: string[]) => xs.map((id) => states[id]).filter(Boolean).sort((a, b) => RANK[a] - RANK[b])[0] as FactState | undefined;
const recallTally = (['strong', 'learning', 'lapsed', 'unseen'] as const).map((k) => [k, Object.values(states).filter((s) => s === k).length] as const).filter(([, n]) => n);
const started = Object.values(states).some((s) => s !== 'unseen');
const resumeAt = visitPos(Astro.locals.user!.id, 'topic', Astro.url.pathname);
const resume = resumeAt !== null && resumeAt > 0.05 && resumeAt < 0.95 ? resumeAt : null;
// Quick check: up to five recall cards spread across the note, then the past-paper questions printed on its pages.
const recall = fs.filter((f) => f.label !== 'disputed' && cardByFact.has(f.id));
const checks = (recall.length <= 5 ? recall : [0, 1, 2, 3, 4].map((k) => recall[Math.floor((k * recall.length) / 5)])).map((f) => cardByFact.get(f.id)!);
const pastQs = mcqs.filter((m) => inPlayer(m) && mcqTopics.get(m.qid)?.includes(t.slug)).slice(0, 6);
const sources = [...new Set(fs.flatMap((f) => f.sources))];
const files = [...new Map(fs.map((f) => [`${f.file}|${f.unit}`, { label: `${f.file} p${f.unit}`, href: sourceHref(f.file, f.unit) }])).values()];
const siblings = topics.filter((x) => x.system === system).sort((a, b) => a.title.localeCompare(b.title));
const idx = siblings.findIndex((x) => x.slug === slug);
const prev = siblings[idx - 1], next = siblings[idx + 1];
const anchor = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const counts = ['cited', 'agreed', 'unchecked', 'disputed'].map((l) => [l, fs.filter((f) => f.label === l).length] as const).filter(([, n]) => n);
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const peers = compareWith(t);
const printedAt = new Date(Date.now() + 5 * 3_600_000).toISOString().slice(0, 10);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<App title={t.title} crumbs={[{ label: 'Study', href: '/study' }, { label: SYSTEMS[t.system].label, href: `/study/${t.system}` }]}>
  <div class="readbar" aria-hidden="true" data-no-print></div>
  <div class="reader">
    <article class="min-w-0">
      <header class="reveal" style="--i:0">
        <p class="print-only print-kicker">Lightbox · {SYSTEMS[t.system].label} · topic note</p>
        <h1 class="text-[1.75rem] font-medium leading-tight sm:text-[2rem]">{t.title}</h1>
        <p class="mt-2 max-w-[65ch] text-[1.0625rem] text-muted">{t.oneLiner}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {counts.map(([l, n]) => <span class={`badge s-${l}`}>{n} {l}</span>)}
          <span class="text-xs text-faint">from {files.length} source page{files.length === 1 ? '' : 's'}</span>
        </div>
        {started && (
          <p class="recall mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted" data-no-print>
            <span class="text-faint">Your recall</span>
            {recallTally.map(([k, n]) => <span class="inline-flex items-center gap-1.5"><span class={`ms ms-${k}`} aria-hidden="true"></span><span class="num text-ink">{n}</span> {MASTERY[k].toLowerCase()}</span>)}
            {recallTally.some(([k]) => k === 'lapsed') && <a href={`/fix/${t.slug}`} class="inline-flex items-center gap-1 text-accent hover:underline"><Icon name="Wrench" size={12} />Fix it</a>}
          </p>
        )}
        {resume !== null && (
          <button type="button" class="chip mt-3" data-resume={resume} data-no-print><Icon name="CornerDownRight" size={14} />Resume where you left off ({Math.round(resume * 100)}%)</button>
        )}
        <div class="actions mt-4 flex flex-wrap items-center gap-1.5" data-no-print>
          {deck.cards > 0 && (
            <button type="button" class="btn btn-sm btn-primary" data-learn={t.slug} title={toLearn ? `Add ${toLearn} flashcards from this topic to your deck and start` : 'Review this topic’s flashcards'}>
              <Icon name="Layers" size={15} />{toLearn ? `Learn this topic (${toLearn} cards)` : `Review ${deck.cards} cards`}
            </button>
          )}
          <button type="button" class="btn btn-sm btn-ghost max-sm:!px-2" data-selftest aria-pressed="false" title="Blur every point; tap one to reveal it"><Icon name="EyeOff" size={15} /><span class="max-sm:sr-only">Self-test</span></button>
          <button type="button" class="btn btn-sm btn-ghost max-sm:!px-2" data-speak aria-pressed="false" title="Read this note aloud" hidden><Icon name="Volume2" size={15} /><span class="max-sm:sr-only" data-speak-label>Listen</span></button>
          <span class="mx-0.5 h-5 w-px bg-line max-sm:hidden" aria-hidden="true"></span>
          <MarkToggle type="topic" id={t.slug} kind="bookmark" />
          <MarkToggle type="topic" id={t.slug} kind="weak" />
          <CollectMenu client:visible itemType="topic" itemId={t.slug} />
          <span class="mx-0.5 h-5 w-px bg-line max-sm:hidden" aria-hidden="true"></span>
          <a href={`/study/compare?t=${t.slug}`} class="btn btn-sm btn-ghost max-sm:!px-2" title="Compare with other topics"><Icon name="Columns3" size={15} /><span class="max-sm:sr-only">Compare</span></a>
          <button type="button" class="btn btn-sm btn-ghost max-sm:!px-2" data-print title="Save as PDF"><Icon name="Printer" size={15} /><span class="max-sm:sr-only">Save as PDF</span></button>
          <a href={`/tutor?topic=${t.slug}`} class="btn btn-sm btn-ghost max-sm:!px-2" title="Ask the AI tutor about this topic"><Icon name="Sparkles" size={15} /><span class="max-sm:sr-only">Ask tutor</span></a>
          <AiGenerate client:visible topicSlug={t.slug} compact />
          <ReportButton client:visible itemType="topic" itemId={t.slug} compact />
        </div>
      </header>

      {t.sections.map((s, si) => (
        <section id={anchor(s.heading)} class="reveal mt-8 scroll-mt-24" style={`--i:${si + 1}`}>
          <h2 class="flex items-center gap-2 text-lg font-medium">{s.heading}</h2>
          <ul class="mt-3 space-y-2.5">
            {s.bullets.map((b) => {
              const paper = b.text.startsWith('Paper differs:');
              const ms = started ? mastery(b.ids) : undefined;
              return (
                <li class:list={['point', { paper }]} data-fact={b.ids[0]}>
                  <span class={`dot s-${b.label ?? 'neutral'}`} aria-hidden="true"></span>
                  <div class="min-w-0 flex-1">
                    <p class="max-w-[68ch] leading-relaxed">{paper ? <><span class="font-medium text-signal">Paper differs. </span>{b.text.replace('Paper differs:', '').trim()}</> : b.text}</p>
                    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                      <Status label={b.label} />
                      {b.ids.map((id) => <FactPop id={id} />)}
                      {ms && ms !== 'unseen' && <span class="mtag" data-no-print><span class={`ms ms-${ms}`} aria-hidden="true"></span>{MASTERY[ms]}</span>}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      {(checks.length > 0 || pastQs.length > 0) && (
        <section id="quick-check" class="qc panel mt-12 scroll-mt-24 p-5" aria-labelledby="qc-h" data-no-print>
          <h2 id="qc-h" class="flex items-center gap-2 text-lg font-medium"><Icon name="ListChecks" size={18} class="text-accent" />Quick check</h2>
          <p class="mt-1 text-sm text-muted">Say the answer out loud before you open each one. Recalling beats re-reading.</p>
          {checks.length > 0 && (
            <ol class="mt-4 grid gap-2">
              {checks.map((c, i) => (
                <li><details class="qc-card"><summary><span class="num text-faint">{i + 1}</span><span class="flex-1">{c.front}</span><Icon name="ChevronDown" size={15} class="chev shrink-0 text-faint" /></summary><p class="qc-back">{c.back}</p></details></li>
              ))}
            </ol>
          )}
          {pastQs.length > 0 && (
            <div class="mt-5">
              <h3 class="text-xs font-medium tracking-wide text-faint">Past-paper questions on this topic</h3>
              <ul class="mt-2 grid gap-1.5 text-sm">
                {pastQs.map((m) => <li><a href={`/practice/mcq?q=${encodeURIComponent(m.qid)}`} class="qc-q"><Icon name="CircleHelp" size={14} class="mt-0.5 shrink-0 text-faint" /><span class="line-clamp-2">{m.stem}</span></a></li>)}
              </ul>
            </div>
          )}
        </section>
      )}

      <footer class="print-only print-foot">
        {sources.length > 0 && <><h2>Checked against</h2><ul>{sources.map((u) => <li>{u}</li>)}</ul></>}
        <h2>From the papers</h2>
        <ul>{files.map((f) => <li>{f.label}</li>)}</ul>
        <p class="print-key">{(['cited', 'agreed', 'unchecked', 'disputed'] as const).map((l) => `${LABELS[l].text}: ${LABELS[l].hint.toLowerCase()}.`).join(' ')}</p>
        <p>Printed from {canonical} on {printedAt}.</p>
      </footer>

      <section class="mt-12" data-no-print><Thread client:visible itemType="topic" itemId={t.slug} title="Discussion" /></section>

      <nav class="mt-12 grid gap-3 sm:grid-cols-2" aria-label="More topics in this system" data-no-print>
        {prev ? <a href={`/study/${system}/${prev.slug}`} class="panel lift p-4"><span class="flex items-center gap-1 text-xs text-faint"><Icon name="ArrowLeft" size={13} />Previous</span><span class="mt-1 block truncate">{prev.title}</span></a> : <span></span>}
        {next && <a href={`/study/${system}/${next.slug}`} class="panel lift p-4 text-right"><span class="flex items-center justify-end gap-1 text-xs text-faint">Next<Icon name="ArrowRight" size={13} /></span><span class="mt-1 block truncate">{next.title}</span></a>}
      </nav>
    </article>

    <aside class="side">
      <div class="sticky top-24 space-y-6">
        {t.sections.length > 1 && (
          <nav aria-label="On this page">
            <h2 class="text-xs font-medium tracking-wide text-faint">On this page</h2>
            <ul class="mt-2 space-y-1 text-sm" data-toc>
              {t.sections.map((s) => <li><a href={`#${anchor(s.heading)}`} class="toc-link">{s.heading}</a></li>)}
            </ul>
          </nav>
        )}
        {sources.length > 0 && (
          <div>
            <h2 class="text-xs font-medium tracking-wide text-faint">Checked against</h2>
            <ul class="mt-2 space-y-1.5 text-sm">
              {sources.slice(0, 8).map((u) => <li><a href={u} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-muted hover:text-accent"><Icon name="ExternalLink" size={13} class="shrink-0" /><span class="truncate">{host(u)}</span></a></li>)}
            </ul>
          </div>
        )}
        <div>
          <h2 class="text-xs font-medium tracking-wide text-faint">From the papers</h2>
          <ul class="mt-2 space-y-1 text-xs text-muted">{files.slice(0, 8).map((p) => <li class="truncate" title={p.label}>{p.href ? <a href={p.href} class="hover:text-accent">{p.label}</a> : p.label}</li>)}</ul>
        </div>
        {peers.length > 0 && (
          <div>
            <h2 class="text-xs font-medium tracking-wide text-faint">Compare with</h2>
            <ul class="mt-2 space-y-0.5 text-sm">
              {peers.map((p) => <li><a href={`/study/compare?t=${t.slug},${p.slug}`} class="peer"><Icon name="ArrowLeftRight" size={13} class="shrink-0 text-faint" /><span class="truncate">{p.title}</span></a></li>)}
            </ul>
          </div>
        )}
      </div>
    </aside>
  </div>
</App>

<script>
  function toc() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
    if (!links.length) return;
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) links.forEach((l) => l.classList.toggle('on', l.hash === '#' + e.target.id));
    }, { rootMargin: '-20% 0px -70% 0px' });
    links.forEach((l) => { const s = document.querySelector(l.hash); if (s) io.observe(s); });
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  function init() {
    toc();
    // onclick, not addEventListener: the topic and print pages both bind [data-print] after every swap.
    document.querySelectorAll<HTMLElement>('[data-print]').forEach((b) => { b.onclick = () => window.print(); });
    learn();
    selfTest();
    speak();
    resume();
  }
  // Resume: jump back to the saved spot, and remember how far down the note the reader gets.
  function resume() {
    const chip = document.querySelector<HTMLButtonElement>('[data-resume]');
    const max = () => Math.max(1, document.documentElement.scrollHeight - innerHeight);
    if (chip) chip.onclick = () => { scrollTo({ top: Number(chip.dataset.resume) * max(), behavior: 'smooth' }); chip.remove(); };
    if (!document.querySelector('.readbar')) return;
    const ref = location.pathname;
    let last = -1, timer = 0, moved = false;
    const save = () => {
      clearTimeout(timer);
      if (!moved) return;
      const pos = Math.round((scrollY / max()) * 100) / 100;
      if (Math.abs(pos - last) < 0.02) return;
      last = pos;
      fetch('/api/resume', { method: 'POST', keepalive: true, headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: 'topic', ref, pos }) }).catch(() => {});
    };
    const onScroll = () => { moved = true; clearTimeout(timer); timer = window.setTimeout(save, 2000); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('pagehide', save);
    document.addEventListener('astro:before-swap', () => { save(); removeEventListener('scroll', onScroll); removeEventListener('pagehide', save); }, { once: true });
  }
  function learn() {
    const b = document.querySelector<HTMLButtonElement>('[data-learn]');
    if (!b) return;
    b.onclick = async () => {
      const slug = b.dataset.learn!;
      b.disabled = true;
      const r = await fetch('/api/srs/learn', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ topic: slug }) }).catch(() => null);
      if (r?.ok) location.assign(`/practice/cards?topic=${encodeURIComponent(slug)}`);
      else { b.disabled = false; b.title = 'Could not add the cards. Try again.'; }
    };
  }
  // Self-test: every point blurs; a tap (or Enter) reveals one.
  function selfTest() {
    const b = document.querySelector<HTMLButtonElement>('[data-selftest]');
    const art = b?.closest('.reader');
    if (!b || !art) return;
    const points = [...art.querySelectorAll<HTMLElement>('.point')];
    const reveal = (p: HTMLElement) => { p.classList.add('shown'); p.removeAttribute('tabindex'); p.removeAttribute('role'); };
    b.onclick = () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on));
      art.classList.toggle('selftest', on);
      points.forEach((p) => {
        p.classList.remove('shown');
        if (on) { p.tabIndex = 0; p.setAttribute('role', 'button'); p.setAttribute('aria-label', 'Hidden point. Press to reveal.'); }
        else { p.removeAttribute('tabindex'); p.removeAttribute('role'); p.removeAttribute('aria-label'); }
      });
    };
    points.forEach((p) => {
      p.onclick = (e) => { if (art.classList.contains('selftest') && !p.classList.contains('shown')) { e.preventDefault(); reveal(p); p.removeAttribute('aria-label'); } };
      p.onkeydown = (e) => { if ((e.key === 'Enter' || e.key === ' ') && art.classList.contains('selftest') && !p.classList.contains('shown')) { e.preventDefault(); reveal(p); p.removeAttribute('aria-label'); } };
    });
  }
  // Read aloud with the browser's own voice: title, then each point, highlighting the one being read.
  function speak() {
    const b = document.querySelector<HTMLButtonElement>('[data-speak]');
    if (!b || !('speechSynthesis' in window)) return;
    b.hidden = false;
    const label = b.querySelector('[data-speak-label]');
    const synth = window.speechSynthesis;
    const stop = () => { synth.cancel(); b.setAttribute('aria-pressed', 'false'); if (label) label.textContent = 'Listen'; document.querySelectorAll('.point.reading').forEach((p) => p.classList.remove('reading')); };
    b.onclick = () => {
      if (b.getAttribute('aria-pressed') === 'true') return stop();
      synth.cancel();
      const voice = synth.getVoices().find((v) => /^en-(GB|IN|PK)/i.test(v.lang)) ?? synth.getVoices().find((v) => v.lang.startsWith('en'));
      const parts: [string, HTMLElement | null][] = [[document.querySelector('.reader h1')?.textContent ?? '', null]];
      document.querySelectorAll<HTMLElement>('.reader article section[id]:not(#quick-check)').forEach((s) => {
        parts.push([s.querySelector('h2')?.textContent ?? '', null]);
        s.querySelectorAll<HTMLElement>('.point').forEach((p) => parts.push([p.querySelector('p')?.textContent ?? '', p]));
      });
      parts.filter(([t]) => t.trim()).forEach(([t, el], i, all) => {
        const u = new SpeechSynthesisUtterance(t);
        if (voice) u.voice = voice;
        u.rate = 0.95;
        u.onstart = () => { document.querySelectorAll('.point.reading').forEach((p) => p.classList.remove('reading')); el?.classList.add('reading'); el?.scrollIntoView({ block: 'center', behavior: 'smooth' }); };
        if (i === all.length - 1) u.onend = stop;
        synth.speak(u);
      });
      b.setAttribute('aria-pressed', 'true');
      if (label) label.textContent = 'Stop';
    };
    document.addEventListener('astro:before-swap', stop, { once: true });
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  .reader { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 3rem; }
  .point { display: flex; gap: 0.85rem; padding: 0.75rem 0.9rem; margin: 0 -0.9rem; border-radius: 12px; transition: background-color var(--d1); }
  .point:hover { background: color-mix(in oklab, var(--ink) 3.5%, transparent); }
  .point.paper { background: color-mix(in oklab, var(--signal) 7%, transparent); }
  .dot { margin-top: 0.62rem; width: 0.4rem; height: 0.4rem; border-radius: 99px; background: var(--c); flex: none; box-shadow: 0 0 0 4px color-mix(in oklab, var(--c) 16%, transparent); }
  .toc-link { display: block; padding: 0.2rem 0 0.2rem 0.75rem; border-left: 1px solid var(--line); color: var(--muted); transition: color var(--d1), border-color var(--d1); }
  .toc-link:hover { color: var(--ink); }
  .toc-link.on { color: var(--accent); border-color: var(--accent); }
  .peer { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0; color: var(--muted); transition: color var(--d1); }
  .peer:hover { color: var(--accent); }
  /* Self-test: points blur until tapped. */
  .selftest .point:not(.shown) p { filter: blur(6px); user-select: none; transition: filter var(--d2); }
  .selftest .point:not(.shown) { cursor: pointer; }
  .selftest .point:not(.shown):hover p { filter: blur(4px); }
  .selftest .point:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .point.reading { background: color-mix(in oklab, var(--accent) 10%, transparent); }
  .ms { display: inline-block; width: 0.45rem; height: 0.45rem; border-radius: 99px; background: var(--mc); flex: none; }
  .ms-strong { --mc: var(--ok); } .ms-learning { --mc: var(--signal); } .ms-lapsed { --mc: var(--bad); } .ms-unseen { --mc: transparent; box-shadow: inset 0 0 0 1px var(--line-strong); }
  .mtag { display: inline-flex; align-items: center; gap: 0.35rem; margin-left: 0.25rem; font-size: 0.6875rem; color: var(--faint); }
  .qc-card { border: 1px solid var(--line); border-radius: 12px; background: var(--sunk); }
  .qc-card summary { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.7rem 0.9rem; cursor: pointer; list-style: none; line-height: 1.5; }
  .qc-card summary::-webkit-details-marker { display: none; }
  .qc-card[open] :global(.chev) { transform: rotate(180deg); }
  .qc-back { padding: 0 0.9rem 0.8rem 2.1rem; color: var(--ok); font-weight: 500; line-height: 1.5; }
  .qc-q { display: flex; gap: 0.5rem; color: var(--muted); transition: color var(--d1); }
  .qc-q:hover { color: var(--accent); }
  /* Reading progress: a hairline that fills along the topbar edge as the page scrolls. */
  .readbar { position: fixed; z-index: 16; top: calc(3.75rem - 2px); left: 0; right: 0; height: 2px; background: var(--accent); transform-origin: left; transform: scaleX(0); pointer-events: none; }
  /* Longhands on purpose: the CSS minifier folds `animation` + `animation-timeline` into one shorthand, which browsers reject. */
  @supports (animation-timeline: scroll()) { .readbar { animation-name: read; animation-duration: auto; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root block); } }
  @supports not (animation-timeline: scroll()) { .readbar { display: none; } }
  @keyframes read { to { transform: scaleX(1); } }
  @media (max-width: 1023px) { .reader { grid-template-columns: 1fr; } .side { display: none; } }
  @media (max-width: 767px) { .readbar { top: calc(3.4rem - 2px); } }
  /* Focus mode: one centred column, a touch larger and airier. */
  :global([data-focus="on"]) .reader { grid-template-columns: minmax(0, 1fr); max-width: 46rem; margin-inline: auto; }
  :global([data-focus="on"]) .side { display: none; }
  :global([data-focus="on"]) .point p { font-size: 1.0625rem; line-height: 1.85; }
