---
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import Status from '../../../components/Status.astro';
import FactPop from '../../../components/FactPop.astro';
import MarkToggle from '../../../components/MarkToggle.astro';
import CollectMenu from '../../../components/islands/CollectMenu';
import ReportButton from '../../../components/islands/ReportButton';
import Thread from '../../../components/islands/Thread';
import AiGenerate from '../../../components/islands/AiGenerate';
import { factById, topics, topicBySlug, SYSTEMS, LABELS } from '../../../lib/data';
import { noteVisit } from '../../../server/progress';
import { compareWith } from '../../../server/study';
import { sourceHref } from '../../../lib/sources';

const { system, slug } = Astro.params;
const t = topicBySlug.get(slug!);
if (!t || t.system !== system) return Astro.redirect(`/study/${system ?? ''}`);
noteVisit(Astro.locals.user!.id, 'topic', Astro.url.pathname, t.title);

const ids = [...new Set(t.sections.flatMap((s) => s.bullets.flatMap((b) => b.ids)))];
const fs = ids.map((id) => factById.get(id)!).filter(Boolean);
const sources = [...new Set(fs.flatMap((f) => f.sources))];
const files = [...new Map(fs.map((f) => [`${f.file}|${f.unit}`, { label: `${f.file} p${f.unit}`, href: sourceHref(f.file, f.unit) }])).values()];
const siblings = topics.filter((x) => x.system === system).sort((a, b) => a.title.localeCompare(b.title));
const idx = siblings.findIndex((x) => x.slug === slug);
const prev = siblings[idx - 1], next = siblings[idx + 1];
const anchor = (h: string) => h.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const counts = ['cited', 'agreed', 'unchecked', 'disputed'].map((l) => [l, fs.filter((f) => f.label === l).length] as const).filter(([, n]) => n);
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const peers = compareWith(t);
const printedAt = new Date(Date.now() + 5 * 3_600_000).toISOString().slice(0, 10);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<App title={t.title} crumbs={[{ label: 'Study', href: '/study' }, { label: SYSTEMS[t.system].label, href: `/study/${t.system}` }]}>
  <div class="readbar" aria-hidden="true" data-no-print></div>
  <div class="reader">
    <article class="min-w-0">
      <header class="reveal" style="--i:0">
        <p class="print-only print-kicker">Lightbox · {SYSTEMS[t.system].label} · topic note</p>
        <h1 class="text-[1.75rem] font-medium leading-tight sm:text-[2rem]">{t.title}</h1>
        <p class="mt-2 max-w-[65ch] text-[1.0625rem] text-muted">{t.oneLiner}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {counts.map(([l, n]) => <span class={`badge s-${l}`}>{n} {l}</span>)}
          <span class="text-xs text-faint">from {files.length} source page{files.length === 1 ? '' : 's'}</span>
        </div>
        <div class="actions mt-4 flex flex-wrap items-center gap-1.5" data-no-print>
          <MarkToggle type="topic" id={t.slug} kind="bookmark" />
          <MarkToggle type="topic" id={t.slug} kind="weak" />
          <CollectMenu client:visible itemType="topic" itemId={t.slug} />
          <span class="mx-0.5 h-5 w-px bg-line max-sm:hidden" aria-hidden="true"></span>
          <a href={`/study/compare?t=${t.slug}`} class="btn btn-sm btn-ghost max-sm:!px-2" title="Compare with other topics"><Icon name="Columns3" size={15} /><span class="max-sm:sr-only">Compare</span></a>
          <button type="button" class="btn btn-sm btn-ghost max-sm:!px-2" data-print title="Save as PDF"><Icon name="Printer" size={15} /><span class="max-sm:sr-only">Save as PDF</span></button>
          <a href={`/tutor?topic=${t.slug}`} class="btn btn-sm btn-ghost max-sm:!px-2" title="Ask the AI tutor about this topic"><Icon name="Sparkles" size={15} /><span class="max-sm:sr-only">Ask tutor</span></a>
          <AiGenerate client:visible topicSlug={t.slug} compact />
          <ReportButton client:visible itemType="topic" itemId={t.slug} compact />
        </div>
      </header>

      {t.sections.map((s, si) => (
        <section id={anchor(s.heading)} class="reveal mt-8 scroll-mt-24" style={`--i:${si + 1}`}>
          <h2 class="flex items-center gap-2 text-lg font-medium">{s.heading}</h2>
          <ul class="mt-3 space-y-2.5">
            {s.bullets.map((b) => {
              const paper = b.text.startsWith('Paper differs:');
              return (
                <li class:list={['point', { paper }]} data-fact={b.ids[0]}>
                  <span class={`dot s-${b.label ?? 'neutral'}`} aria-hidden="true"></span>
                  <div class="min-w-0 flex-1">
                    <p class="max-w-[68ch] leading-relaxed">{paper ? <><span class="font-medium text-signal">Paper differs. </span>{b.text.replace('Paper differs:', '').trim()}</> : b.text}</p>
                    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                      <Status label={b.label} />
                      {b.ids.map((id) => <FactPop id={id} />)}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}

      <footer class="print-only print-foot">
        {sources.length > 0 && <><h2>Checked against</h2><ul>{sources.map((u) => <li>{u}</li>)}</ul></>}
        <h2>From the papers</h2>
        <ul>{files.map((f) => <li>{f.label}</li>)}</ul>
        <p class="print-key">{(['cited', 'agreed', 'unchecked', 'disputed'] as const).map((l) => `${LABELS[l].text}: ${LABELS[l].hint.toLowerCase()}.`).join(' ')}</p>
        <p>Printed from {canonical} on {printedAt}.</p>
      </footer>

      <section class="mt-12" data-no-print><Thread client:visible itemType="topic" itemId={t.slug} title="Discussion" /></section>

      <nav class="mt-12 grid gap-3 sm:grid-cols-2" aria-label="More topics in this system" data-no-print>
        {prev ? <a href={`/study/${system}/${prev.slug}`} class="panel lift p-4"><span class="flex items-center gap-1 text-xs text-faint"><Icon name="ArrowLeft" size={13} />Previous</span><span class="mt-1 block truncate">{prev.title}</span></a> : <span></span>}
        {next && <a href={`/study/${system}/${next.slug}`} class="panel lift p-4 text-right"><span class="flex items-center justify-end gap-1 text-xs text-faint">Next<Icon name="ArrowRight" size={13} /></span><span class="mt-1 block truncate">{next.title}</span></a>}
      </nav>
    </article>

    <aside class="side">
      <div class="sticky top-24 space-y-6">
        {t.sections.length > 1 && (
          <nav aria-label="On this page">
            <h2 class="text-xs font-medium tracking-wide text-faint">On this page</h2>
            <ul class="mt-2 space-y-1 text-sm" data-toc>
              {t.sections.map((s) => <li><a href={`#${anchor(s.heading)}`} class="toc-link">{s.heading}</a></li>)}
            </ul>
          </nav>
        )}
        {sources.length > 0 && (
          <div>
            <h2 class="text-xs font-medium tracking-wide text-faint">Checked against</h2>
            <ul class="mt-2 space-y-1.5 text-sm">
              {sources.slice(0, 8).map((u) => <li><a href={u} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-muted hover:text-accent"><Icon name="ExternalLink" size={13} class="shrink-0" /><span class="truncate">{host(u)}</span></a></li>)}
            </ul>
          </div>
        )}
        <div>
          <h2 class="text-xs font-medium tracking-wide text-faint">From the papers</h2>
          <ul class="mt-2 space-y-1 text-xs text-muted">{files.slice(0, 8).map((p) => <li class="truncate" title={p.label}>{p.href ? <a href={p.href} class="hover:text-accent">{p.label}</a> : p.label}</li>)}</ul>
        </div>
        {peers.length > 0 && (
          <div>
            <h2 class="text-xs font-medium tracking-wide text-faint">Compare with</h2>
            <ul class="mt-2 space-y-0.5 text-sm">
              {peers.map((p) => <li><a href={`/study/compare?t=${t.slug},${p.slug}`} class="peer"><Icon name="ArrowLeftRight" size={13} class="shrink-0 text-faint" /><span class="truncate">{p.title}</span></a></li>)}
            </ul>
          </div>
        )}
      </div>
    </aside>
  </div>
</App>

<script>
  function toc() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
    if (!links.length) return;
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) links.forEach((l) => l.classList.toggle('on', l.hash === '#' + e.target.id));
    }, { rootMargin: '-20% 0px -70% 0px' });
    links.forEach((l) => { const s = document.querySelector(l.hash); if (s) io.observe(s); });
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  function init() {
    toc();
    // onclick, not addEventListener: the topic and print pages both bind [data-print] after every swap.
    document.querySelectorAll<HTMLElement>('[data-print]').forEach((b) => { b.onclick = () => window.print(); });
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  .reader { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 3rem; }
  .point { display: flex; gap: 0.85rem; padding: 0.75rem 0.9rem; margin: 0 -0.9rem; border-radius: 12px; transition: background-color var(--d1); }
  .point:hover { background: color-mix(in oklab, var(--ink) 3.5%, transparent); }
  .point.paper { background: color-mix(in oklab, var(--signal) 7%, transparent); }
  .dot { margin-top: 0.62rem; width: 0.4rem; height: 0.4rem; border-radius: 99px; background: var(--c); flex: none; box-shadow: 0 0 0 4px color-mix(in oklab, var(--c) 16%, transparent); }
  .toc-link { display: block; padding: 0.2rem 0 0.2rem 0.75rem; border-left: 1px solid var(--line); color: var(--muted); transition: color var(--d1), border-color var(--d1); }
  .toc-link:hover { color: var(--ink); }
  .toc-link.on { color: var(--accent); border-color: var(--accent); }
  .peer { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0; color: var(--muted); transition: color var(--d1); }
  .peer:hover { color: var(--accent); }
  /* Reading progress: a hairline that fills along the topbar edge as the page scrolls. */
  .readbar { position: fixed; z-index: 16; top: calc(3.75rem - 2px); left: 0; right: 0; height: 2px; background: var(--accent); transform-origin: left; transform: scaleX(0); pointer-events: none; }
  /* Longhands on purpose: the CSS minifier folds `animation` + `animation-timeline` into one shorthand, which browsers reject. */
  @supports (animation-timeline: scroll()) { .readbar { animation-name: read; animation-duration: auto; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root block); } }
  @supports not (animation-timeline: scroll()) { .readbar { display: none; } }
  @keyframes read { to { transform: scaleX(1); } }
  @media (max-width: 1023px) { .reader { grid-template-columns: 1fr; } .side { display: none; } }
  @media (max-width: 767px) { .readbar { top: calc(3.4rem - 2px); } }
  /* Focus mode: one centred column, a touch larger and airier. */
  :global([data-focus="on"]) .reader { grid-template-columns: minmax(0, 1fr); max-width: 46rem; margin-inline: auto; }
  :global([data-focus="on"]) .side { display: none; }
  :global([data-focus="on"]) .point p { font-size: 1.0625rem; line-height: 1.85; }
  :global([data-focus="on"]) .point .dot { margin-top: 0.78rem; }
  :global([data-focus="on"]) .reader h1 { font-size: 2.15rem; }
</style>
