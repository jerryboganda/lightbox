---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import { coverage, images, shortFile, stats } from '../../lib/data';
import { fileOrder, isImageFile, sourceHref, unitsByFile, unitWord } from '../../lib/sources';

const mods = import.meta.glob<{ default: ImageMetadata }>('/src/assets/atlas/*', { eager: true });
const byName = new Map(Object.entries(mods).map(([p, m]) => [p.split('/').pop()!, m.default]));
const rows = await Promise.all(fileOrder.map(async (file) => {
  const units = unitsByFile.get(file)!;
  const withFacts = units.filter((u) => u.status === 'facts');
  const img = images.find((i) => i.sourceFile === file && byName.has(i.file));
  const thumb = isImageFile(file) && img ? (await getImage({ src: byName.get(img.file)!, width: 320, format: 'webp', quality: 70 })).src : null;
  return {
    file, units, thumb, short: shortFile(file),
    type: coverage.find((c) => c.name === file)?.type ?? file.split('.').pop()!,
    word: unitWord(file), withFacts: withFacts.length,
    facts: units.reduce((a, u) => a + u.factCount, 0), max: Math.max(1, ...units.map((u) => u.factCount)),
    href: sourceHref(file, (withFacts[0] ?? units[0]).page)!,
  };
}));
const docs = rows.filter((r) => !isImageFile(r.file));
const pics = rows.filter((r) => isImageFile(r.file));
const totalFacts = rows.reduce((a, r) => a + r.facts, 0);
const metrics = [
  { n: rows.length, l: 'source files' },
  { n: stats.units, l: 'pages, slides and images' },
  { n: stats.unitsWithFacts, l: 'with examinable facts' },
  { n: totalFacts, l: 'facts traced to a page' },
];
const busiest = (r: (typeof rows)[number]) => r.units.reduce((a, u) => (u.factCount > a.factCount ? u : a), r.units[0]);
---
<App title="Sources">
  <header class="reveal" style="--i:0">
    <h1 class="text-2xl font-medium">Source pages</h1>
    <p class="mt-1 max-w-2xl text-muted">The original text of every pilot page and slide, exactly as it was extracted, beside the facts taken from it.</p>
  </header>

  <dl class="reveal mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4" style="--i:1" data-sources>
    {metrics.map((m) => <div class="panel px-4 py-3.5"><dd class="num text-2xl" data-count={m.n}>{m.n}</dd><dt class="text-xs text-muted">{m.l}</dt></div>)}
  </dl>

  <section class="mt-9" aria-labelledby="docs-h">
    <div class="reveal flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1" style="--i:2">
      <h2 id="docs-h" class="whitespace-nowrap font-medium">Papers and slide decks</h2>
      <p class="flex items-center gap-3 text-xs text-muted" aria-hidden="true"><span class="flex items-center gap-1.5"><span class="h-2.5 w-1.5 rounded-sm bg-accent"></span>facts per page</span><span class="flex items-center gap-1.5"><span class="h-1 w-1.5 rounded-sm bg-line-strong"></span>nothing examinable</span></p>
    </div>
    <ul class="mt-3 grid gap-3 lg:grid-cols-2">
      {docs.map((r, i) => {
        const top = busiest(r);
        return (
          <li class="reveal" style={`--i:${Math.min(i + 3, 12)}`}>
            <a href={r.href} class="panel lift press group flex h-full flex-col p-4 sm:p-5">
              <div class="flex items-start gap-3">
                <span class="badge s-neutral w-12 shrink-0 justify-center uppercase before:hidden">{r.type}</span>
                <span class="min-w-0 flex-1">
                  <span class="block font-medium leading-snug transition-colors group-hover:text-accent">{r.short}</span>
                  <span class="mt-0.5 block text-xs text-muted"><span class="num">{r.units.length}</span> {r.word.toLowerCase()}s · <span class="num">{r.withFacts}</span> with facts · <span class="num text-ink">{r.facts}</span> facts</span>
                </span>
                <Icon name="ArrowUpRight" size={16} class="mt-0.5 shrink-0 text-faint transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </div>
              <figure class="mt-auto pt-5">
                <div class="spark" role="img" aria-label={`${r.withFacts} of ${r.units.length} ${r.word.toLowerCase()}s have facts; the most, ${top.factCount}, on ${r.word.toLowerCase()} ${top.page}.`}>
                  {r.units.map((u, j) => <span class:list={['bar', { none: !u.factCount }]} style={`--h:${u.factCount ? Math.max(0.14, u.factCount / r.max) : 0.06};--j:${Math.min(j, 40)}`}></span>)}
                </div>
                <figcaption class="mt-1.5 flex justify-between text-[0.75rem] text-muted" aria-hidden="true"><span class="num">{r.word.slice(0, 1).toLowerCase()}1</span><span class="num">{r.word.slice(0, 1).toLowerCase()}{r.units.at(-1)!.page}</span></figcaption>
              </figure>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {pics.length > 0 && (
    <section class="mt-9" aria-labelledby="pics-h">
      <div class="reveal" style="--i:8">
        <h2 id="pics-h" class="font-medium">Shared images</h2>
        <p class="mt-0.5 text-sm text-muted"><span class="num">{pics.length}</span> WhatsApp photos from {pics[0].short.match(/\d{4}-\d{2}-\d{2}/)?.[0] ?? 'the class group'}, each transcribed as one unit. Labelled by the time they were sent.</p>
      </div>
      <ul class="pics mt-3">
        {pics.map((r, i) => (
          <li class="reveal" style={`--i:${Math.min(i + 9, 16)}`}>
            <a href={r.href} class="panel lift press group block h-full overflow-hidden">
              <span class="thumb">{r.thumb ? <img src={r.thumb} alt="" loading={i < 10 ? 'eager' : 'lazy'} decoding="async" /> : <Icon name="Image" size={22} class="text-faint" />}</span>
              <span class="block px-3 py-2.5">
                <span class="block truncate text-sm transition-colors group-hover:text-accent">{r.short.replace(/^WhatsApp Image \d{4}-\d{2}-\d{2} at /, '')}</span>
                <span class="mt-0.5 block text-xs text-muted">{r.facts ? <><span class="num text-ink">{r.facts}</span> fact{r.facts === 1 ? '' : 's'}</> : 'Nothing examinable'}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</App>

<script>
  import { countUp } from '../../scripts/motion';
  const run = () => { if (document.querySelector('[data-sources]')) countUp(); };
  run();
  document.addEventListener('astro:after-swap', run);
</script>

<style>
  .spark { display: flex; align-items: flex-end; gap: 2px; height: 2.75rem; }
  .bar { flex: 1 1 0; min-width: 2px; max-width: 1rem; height: 100%; border-radius: 2px 2px 1px 1px; background: var(--accent); opacity: 0.85; transform-origin: bottom; transform: scaleY(var(--h)); animation: grow var(--d4) var(--ease) both; animation-delay: calc(var(--j) * 12ms + 180ms); transition: opacity var(--d1); }
  .bar.none { background: var(--line-strong); opacity: 1; }
  a:hover .bar:not(.none) { opacity: 1; }
  @keyframes grow { from { transform: scaleY(0); } }
  .pics { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 0.75rem; }
  .thumb { display: grid; place-items: center; aspect-ratio: 16 / 10; background: var(--sunk); border-bottom: 1px solid var(--line); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--d3) var(--ease); }
  a:hover .thumb img { transform: scale(calc(1 + 0.04 * var(--move))); }
  @media (prefers-reduced-motion: reduce) { .bar { animation: none; } }
  :global([data-motion="reduced"]) .bar { animation: none; }
</style>
