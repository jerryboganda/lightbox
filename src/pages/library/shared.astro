---
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import Empty from './_Empty.astro';
import { ago, getCollection, itemInfo, sharedCollections } from '../../server/personal';

const uid = Astro.locals.user!.id;
const list = sharedCollections().map((c) => ({ ...c, preview: getCollection(uid, c.id)!.items.slice(0, 3).map((it) => itemInfo(uid, it.type, it.id)?.title).filter((t): t is string => !!t) }));
const initials = (n: string) => n.split(/\s+/).map((s) => s[0]).join('').slice(0, 2).toUpperCase();
const people = new Set(list.map((c) => c.ownerId)).size;
---
<App title="Class collections" crumbs={[{ label: 'Library', href: '/library' }]}>
  <header class="reveal flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between" style="--i:0">
    <div>
      <h1 class="text-2xl font-medium">Class collections</h1>
      <p class="mt-1 max-w-2xl text-muted">{list.length ? `${list.length} collection${list.length === 1 ? '' : 's'} shared by ${people} ${people === 1 ? 'person' : 'people'}. Open one to read it, or copy it into your own library to make it yours.` : 'Collections your classmates share with the class appear here.'}</p>
    </div>
    <a href="/library?tab=collections" class="btn shrink-0"><Icon name="FolderOpen" size={16} />Your collections</a>
  </header>

  {list.length ? (
    <ul class="grid mt-6" data-no-highlight>
      {list.map((c, i) => (
        <li class="panel lift card reveal" style={`--i:${Math.min(i + 1, 12)}`}>
          <div class="flex items-center gap-2.5">
            <span class="avatar-sm" aria-hidden="true">{initials(c.ownerName)}</span>
            <span class="min-w-0 flex-1 truncate text-sm text-muted">{c.ownerId === uid ? 'You' : c.ownerName}</span>
            <span class="num text-xs text-faint">{c.count} item{c.count === 1 ? '' : 's'}</span>
          </div>
          <h2 class="mt-3 font-medium"><a href={`/library/c/${c.id}`} class="stretch hover:text-accent">{c.name}</a></h2>
          {c.description && <p class="mt-0.5 line-clamp-2 text-sm text-muted">{c.description}</p>}
          {c.preview.length > 0 && <ul class="preview">{c.preview.map((t) => <li>{t}</li>)}</ul>}
          <div class="mt-auto flex items-center justify-between gap-2 pt-4">
            <span class="text-xs text-faint">Updated {ago(c.updatedAt)}</span>
            {c.ownerId === uid ? <span class="badge s-agreed">yours</span> : <button type="button" class="btn btn-sm relative z-[1]" data-act="copy-col" data-id={c.id}><Icon name="Copy" size={14} />Copy</button>}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <div class="mt-6">
      <Empty icon="UsersRound" title="Nothing shared yet" text="When a classmate shares a collection it shows up here. Open one of yours and switch on Share with class to be the first.">
        <a href="/library?tab=collections" class="btn btn-primary"><Icon name="FolderOpen" size={16} />Your collections</a>
      </Empty>
    </div>
  )}
</App>

<script>
  import '../../scripts/library';
</script>

<style>
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .card { position: relative; display: flex; flex-direction: column; padding: 1.1rem 1.2rem; min-height: 12.5rem; }
  .stretch::after { content: ""; position: absolute; inset: 0; border-radius: 14px; }
  .avatar-sm { display: grid; place-items: center; flex: none; width: 1.9rem; height: 1.9rem; border-radius: 99px; font-size: 0.6875rem; font-weight: 600; background: var(--glow); color: color-mix(in oklab, var(--accent) 65%, var(--ink)); border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent); }
  .preview { margin-top: 0.75rem; display: grid; gap: 0.3rem; font-size: 0.8125rem; color: var(--muted); }
  .preview li { position: relative; padding-left: 0.85rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .preview li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 0.3rem; height: 0.3rem; border-radius: 99px; background: color-mix(in oklab, var(--accent) 55%, var(--line)); }
</style>
