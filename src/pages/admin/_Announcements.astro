---
import Icon from '../../components/Icon.astro';
import { listAnnouncements } from '../../server/admin';
import { ago } from '../../server/personal';

const { active, past } = listAnnouncements();
---
<div class="ann">
  <form class="panel ann-new reveal" style="--i:2" data-ann-form aria-labelledby="ann-h">
    <div class="flex items-center gap-2.5"><span class="adm-ico"><Icon name="Megaphone" size={18} /></span><h2 id="ann-h" class="font-medium">New announcement</h2></div>
    <label for="ann-body" class="sr-only">Announcement</label>
    <textarea id="ann-body" name="body" rows="4" maxlength="600" required class="lb-ta mt-4" placeholder="Mock TOACS on Sunday at 10 am in the seminar room." data-count-into="ann-n"></textarea>
    <p class="mt-1 flex justify-between text-xs text-faint"><span>The newest two appear on everyone’s home page.</span><span class="num"><span id="ann-n">0</span>/600</span></p>
    <label class="adm-check mt-3"><input type="checkbox" name="notify" /><Icon name="BellRing" size={15} /><span>Also notify everyone</span></label>
    <button class="btn btn-primary mt-4 w-full justify-center"><Icon name="Send" size={16} />Post to dashboards</button>
  </form>

  <section class="reveal" style="--i:3" aria-labelledby="live-h">
    <h2 id="live-h" class="ann-h">Live on dashboards <span class="num text-faint">{active.length}</span></h2>
    {active.length ? (
      <ul class="mt-2 space-y-2.5">
        {active.map((a, i) => (
          <li class="ann-card" data-ann={a.id}>
            <Icon name="Megaphone" size={17} class="mt-0.5 shrink-0 text-accent" />
            <div class="min-w-0 flex-1">
              <p class="whitespace-pre-line text-sm leading-relaxed">{a.body}</p>
              <p class="mt-1.5 text-xs text-muted">{i < 2 ? 'Showing on home' : 'Older: hidden by newer ones'} · @{a.username ?? 'admin'} · {ago(a.createdAt)}</p>
            </div>
            <button type="button" class="btn btn-sm btn-ghost shrink-0" data-ann-hide={a.id}><Icon name="EyeOff" size={15} />Take down</button>
          </li>
        ))}
      </ul>
    ) : (
      <div class="adm-clear panel mt-2"><span class="adm-ico"><Icon name="Megaphone" size={20} /></span><h3 class="mt-3 font-medium">Nothing posted</h3><p class="mt-1 max-w-sm text-sm text-muted">Exam dates, room changes and mock sessions: post them here and they show at the top of everyone’s home page.</p></div>
    )}
    {past.length > 0 && (
      <>
        <h2 class="ann-h mt-7">Taken down</h2>
        <ul class="mt-2 divide-y divide-line">
          {past.map((a) => <li class="py-2.5 text-sm text-muted"><p class="line-clamp-2 whitespace-pre-line">{a.body}</p><p class="mt-0.5 text-xs text-faint">@{a.username ?? 'admin'} · {ago(a.createdAt)}</p></li>)}
        </ul>
      </>
    )}
  </section>
</div>

<style>
  .ann { display: grid; grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .ann-new { padding: 1.2rem 1.25rem; }
  .ann-h { font-size: 0.8125rem; font-weight: 500; color: var(--muted); }
  .ann-card { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.85rem 0.85rem 0.85rem 1rem; border-radius: 12px; border: 1px solid color-mix(in oklab, var(--accent) 25%, transparent); background: color-mix(in oklab, var(--accent) 7%, var(--panel)); }
  @media (max-width: 900px) { .ann { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .ann-card { flex-wrap: wrap; } .ann-card > .btn { margin-left: auto; } }
</style>
