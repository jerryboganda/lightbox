---
import ChartCard from '../../components/charts/ChartCard.astro';
import { aiUsage } from '../../server/admin';

const u = aiUsage();
const fmt = (n: number) => n.toLocaleString('en-GB');
const k = (n: number) => (n >= 10_000 ? `${Math.round(n / 1000)}k` : n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const long = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
const empty = u.total === 0;
const bars = empty ? u.days.map((d, i) => ({ ...d, n: 3 + ((i * 7) % 9) })) : u.days;
const max = Math.max(1, ...bars.map((d) => d.n));
const top = max <= 5 ? 5 : max <= 10 ? 10 : Math.ceil(max / 10) * 10;
const cellMax = Math.max(1, ...u.users.flatMap((x) => x.n));
const level = (n: number) => (n === 0 ? 0 : Math.min(4, Math.ceil((n / cellMax) * 4)));
const take = empty ? 'Requests and tokens per person per day appear here once classmates use the AI.'
  : `${fmt(u.total)} requests and ${fmt(u.tokens)} tokens in 14 days, from ${u.users.length} ${u.users.length === 1 ? 'person' : 'people'}.`;
---
<div id="usage" class="ai-usage mt-8">
  <ChartCard id="ai-usage" title="AI usage" takeaway={take} i={5}
    empty={empty ? { text: 'No AI requests in the last 14 days.', icon: 'Cpu', cta: 'Open the tutor', href: '/tutor' } : null}>
    <div class="pl-wrap" aria-hidden={empty ? 'true' : undefined}>
      <div class="pl ai-pl" style="--n:14">
        <div class="pl-grid" aria-hidden="true">{[1, 0.5, 0].map((v) => <span style={`top:${(1 - v) * 100}%`}><em>{Math.round(top * v)}</em></span>)}</div>
        <div class="pl-cols" aria-hidden="true">{bars.map((d, i) => <span><i class="pl-bar ai-bar" style={`height:${(d.n / top) * 100}%;--i:${i}`}></i></span>)}</div>
        {!empty && (
          <div class="pl-hits" role="group" aria-label="AI requests per day. Arrow keys move between days." data-rove>
            {u.days.map((d, i) => <span role="img" aria-label={`${long(d.day)}: ${d.n} requests, ${fmt(d.tokens)} tokens`} data-tip={`${long(d.day)}: ${d.n} requests, ${fmt(d.tokens)} tokens`} tabindex={i === 13 ? 0 : -1}></span>)}
          </div>
        )}
      </div>
      <div class="pl-x" style="--n:14" data-thin aria-hidden="true">{u.days.map((d, i) => <span data-now={i === 13 ? '' : undefined}>{Number(d.day.slice(8))}</span>)}</div>
    </div>
    <dl slot="foot" class="ch-foot ai-tot">
      <div class="ch-stat"><dt class="sr-only">Requests, 14 days</dt><dd><b>{fmt(u.total)}</b>requests</dd></div>
      <div class="ch-stat"><dt class="sr-only">Tokens, 14 days</dt><dd><b>{k(u.tokens)}</b>tokens</dd></div>
      <div class="ch-stat"><dt class="sr-only">All time</dt><dd><b>{fmt(u.allTime.n)}</b>all time</dd></div>
      <div class="ch-stat"><dt class="sr-only">Cache</dt><dd><b>{fmt(u.cache.hits)}</b>cache hits · {fmt(u.cache.entries)} cached</dd></div>
    </dl>
    <table slot="table"><caption>AI requests per day, last 14 days</caption><thead><tr><th>Day</th><th>Requests</th><th>Tokens</th></tr></thead>
      <tbody>{u.days.map((d) => <tr><td>{long(d.day)}</td><td>{d.n}</td><td>{d.tokens}</td></tr>)}</tbody></table>
  </ChartCard>

  {u.users.length > 0 && (
    <section class="panel mt-4 overflow-hidden" aria-labelledby="per-h">
      <h3 id="per-h" class="px-5 pt-4 text-sm font-medium">Per person, last 14 days</h3>
      <div class="ut-wrap" tabindex="0" role="region" aria-labelledby="per-h">
        <table class="ut">
          <thead><tr><th scope="col">Person</th><th scope="col"><div class="ut-days" aria-hidden="true">{u.days.map((d, i) => <span data-now={i === 13 ? '' : undefined}>{Number(d.day.slice(8))}</span>)}</div><span class="sr-only">Daily requests</span></th><th scope="col" class="r">Requests</th><th scope="col" class="r">Tokens</th></tr></thead>
          <tbody>
            {u.users.map((x) => (
              <tr>
                <th scope="row"><span class="block truncate font-medium">{x.name}</span><span class="num block text-xs font-normal text-muted">@{x.username}</span></th>
                <td><div class="ut-days">{x.n.map((n, i) => <span class="ut-c" data-l={level(n)} title={`${long(u.days[i].day)}: ${n} requests, ${fmt(x.tokens[i])} tokens`}><span class="sr-only">{long(u.days[i].day)}: {n}</span></span>)}</div></td>
                <td class="num r">{fmt(x.total)}</td>
                <td class="num r text-muted">{fmt(x.totalTokens)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot><tr><th scope="row">Class</th><td><div class="ut-days">{u.days.map((d) => <span class="num ut-sum">{d.n || ''}</span>)}</div></td><td class="num r">{fmt(u.total)}</td><td class="num r text-muted">{fmt(u.tokens)}</td></tr></tfoot>
        </table>
      </div>
    </section>
  )}
</div>

<style>
  .ai-usage { scroll-margin-top: 8rem; }
  .ai-pl { height: 8.5rem; }
  .ai-bar { background: color-mix(in oklab, var(--edition) 80%, transparent); }
  .ai-tot { justify-content: flex-start; gap: 0.5rem 1.6rem; }
  .ai-tot dd { display: flex; align-items: baseline; gap: 0.25rem; }
  .ut-wrap { overflow-x: auto; overscroll-behavior-x: contain; padding: 0.5rem 0 0.75rem; }
  .ut { width: 100%; min-width: 36rem; font-size: 0.875rem; border-collapse: collapse; }
  .ut th, .ut td { padding: 0.5rem 0.6rem; text-align: left; vertical-align: middle; }
  .ut .r { text-align: right; width: 6.5rem; }
  .ut th:first-child { padding-left: 1.25rem; width: 12rem; max-width: 12rem; }
  .ut td:last-child, .ut th:last-child { padding-right: 1.25rem; }
  .ut thead th { font-size: 0.75rem; font-weight: 400; color: var(--faint); }
  .ut tbody tr { border-top: 1px solid var(--line); }
  .ut tfoot tr { border-top: 1px solid var(--line-strong); font-weight: 500; }
  .ut-days { display: grid; grid-template-columns: repeat(14, minmax(0.95rem, 1fr)); gap: 3px; min-width: 15rem; }
  .ut thead .ut-days span, .ut-sum { font-size: 0.625rem; text-align: center; color: var(--faint); font-family: var(--font-mono); }
  .ut thead .ut-days span[data-now] { color: var(--accent); }
  .ut-c { height: 1.1rem; border-radius: 3px; background: var(--sunk); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--line-strong) 45%, transparent); }
  .ut-c[data-l="1"] { background: color-mix(in oklab, var(--edition) 30%, var(--sunk)); }
  .ut-c[data-l="2"] { background: color-mix(in oklab, var(--edition) 52%, var(--sunk)); }
  .ut-c[data-l="3"] { background: color-mix(in oklab, var(--edition) 76%, var(--sunk)); }
  .ut-c[data-l="4"] { background: var(--edition); }
</style>
