---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import ScoreRing from '../../../components/ScoreRing.astro';
import ToacsStation, { type Station } from '../../../components/islands/ToacsStation';
import { answersOf, configOf, load, toacsStations, type Grade } from '../../../server/exams';
import { LABELS, shortFile } from '../../../lib/data';
import { dur, when } from '../../../lib/quiz';
import '../../../styles/practice.css';

const e = load(Astro.locals.user!.id, Number(Astro.params.id));
if (!e) return Astro.redirect('/practice/toacs');
if (e.mode !== 'toacs') return Astro.redirect(`/practice/exam/${e.id}`);
const error = Astro.url.searchParams.get('error')?.slice(0, 120);

const mods = import.meta.glob<{ default: ImageMetadata }>('/src/assets/atlas/*', { eager: true });
const byName = new Map(Object.entries(mods).map(([p, m]) => [p.split('/').pop()!, m.default]));
const ans = answersOf(e.id);
const raw = toacsStations(e);
const stations = await Promise.all(raw.map(async (s) => {
  const src = byName.get(s.file)!;
  const img = await getImage({ src, width: Math.min(e.finished_at ? 480 : 1600, src.width), format: 'webp', quality: e.finished_at ? 70 : 80 });
  const title = s.caption.split('\n').map((l) => l.trim()).find(Boolean) || 'No source caption';
  return {
    file: s.file, src: img.src, w: Number(img.attributes.width ?? src.width), h: Number(img.attributes.height ?? src.height), title, caption: s.caption,
    source: `${shortFile(s.sourceFile)}${s.page ? ` · p${s.page}` : ''}`,
    facts: s.facts.map((f) => ({ ...f, labelText: LABELS[f.label as keyof typeof LABELS]?.text ?? f.label })),
  };
}));
const grades: Record<string, Grade> = {};
for (const [k, a] of ans) if (a.choice) grades[k] = a.choice as Grade;
const count = (g: Grade) => Object.values(grades).filter((x) => x === g).length;
const ms = [...ans.values()].reduce((s, a) => s + a.ms, 0);
const GRADE: Record<Grade, [string, string]> = { got: ['s-cited', 'Got it'], partial: ['s-unchecked', 'Partly'], missed: ['s-disputed', 'Missed'] };
const toRepeat = stations.length - count('got');
---
<App title={e.title} crumbs={[{ label: 'Practice', href: '/practice' }, { label: 'TOACS', href: '/practice/toacs' }]} wide={!e.finished_at}>
  {!e.finished_at ? (
    <ToacsStation client:load id={e.id} seconds={configOf(e).seconds ?? 60} stations={stations.map(({ title, ...s }) => s as Station)} grades={grades} />
  ) : (
    <>
      {error && <p class="reveal mb-4 flex items-center gap-2 rounded-xl border border-signal/30 bg-signal/10 px-4 py-3 text-sm" role="alert"><Icon name="Info" size={16} class="text-signal" />{error}</p>}
      <header class="reveal flex flex-wrap items-end justify-between gap-4" style="--i:0">
        <div class="min-w-0">
          <p class="flex items-center gap-2 text-xs text-muted"><span class="badge s-edition">TOACS</span>Finished {when(e.finished_at)}</p>
          <h1 class="mt-2 text-2xl font-medium">{e.title}</h1>
          <p class="mt-1 text-muted">Self-graded against the source captions. Partly counts as half.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <form method="post" action={`/api/exams/${e.id}/retake`}><button class="btn btn-primary" disabled={!toRepeat}><Icon name="RotateCcw" size={16} />Repeat missed{toRepeat > 0 && <span class="num opacity-80">{toRepeat}</span>}</button></form>
          <a href="/practice/toacs" class="btn"><Icon name="Plus" size={16} />New session</a>
        </div>
      </header>

      <div class="tsum mt-6">
        <section class="panel reveal flex items-center gap-8 p-5 max-sm:flex-col max-sm:items-stretch" style="--i:1" aria-label="Score">
          <ScoreRing value={e.score ?? 0} total={e.total ?? stations.length} label="Score" />
          <dl class="grid flex-1 grid-cols-3 gap-4 text-sm">
            <div><dt class="text-muted">Got it</dt><dd class="num mt-0.5 text-2xl text-ok">{count('got')}</dd></div>
            <div><dt class="text-muted">Partly</dt><dd class="num mt-0.5 text-2xl text-signal">{count('partial')}</dd></div>
            <div><dt class="text-muted">Missed</dt><dd class="num mt-0.5 text-2xl text-bad">{count('missed')}</dd></div>
            <div class="col-span-3"><dt class="text-muted">Time looking</dt><dd class="num mt-0.5">{dur(ms)} <span class="text-xs text-muted">· {dur(ms / Math.max(1, Object.keys(grades).length))} per station · {configOf(e).seconds ?? 60} s allowed</span></dd></div>
          </dl>
        </section>
      </div>

      <h2 class="mt-10 text-lg font-medium">Stations</h2>
      <ul class="thumbs mt-4">
        {stations.map((s, k) => {
          const g = grades[s.file];
          return (
            <li class="reveal" style={`--i:${Math.min(k + 2, 14)}`}>
              <a href={`/atlas?img=${encodeURIComponent(s.file)}`} class="thumb panel lift group" aria-label={`Station ${k + 1}: ${s.title}. ${g ? GRADE[g][1] : 'Not graded'}. Open in the atlas`}>
                <span class="thumb-img"><img src={s.src} alt="" width={s.w} height={s.h} loading="lazy" decoding="async" /></span>
                <span class="flex items-center justify-between gap-2 px-3 pt-2.5 text-xs"><span class="num text-muted">{k + 1}</span>{g ? <span class={`badge ${GRADE[g][0]}`}>{GRADE[g][1]}</span> : <span class="badge s-neutral">Not graded</span>}</span>
                <span class="line-clamp-2 px-3 pb-3 pt-1.5 text-sm group-hover:text-accent">{s.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}
</App>

<script>
  import { countUp } from '../../../scripts/motion';
  const run = () => { if (document.querySelector('.tsum')) countUp(); };
  run();
  document.addEventListener('astro:after-swap', run);
</script>

<style>
  .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.85rem; }
  .thumb { display: block; overflow: hidden; height: 100%; }
  .thumb-img { display: block; aspect-ratio: 4 / 3; background: #05070a; overflow: hidden; }
  .thumb-img img { width: 100%; height: 100%; object-fit: contain; transition: transform var(--d4) var(--ease); }
  .thumb:hover .thumb-img img { transform: scale(calc(1 + 0.04 * var(--move))); }
</style>
