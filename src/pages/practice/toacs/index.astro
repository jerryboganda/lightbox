---
import App from '../../../layouts/App.astro';
import Icon from '../../../components/Icon.astro';
import { images } from '../../../lib/data';
import { TOACS_SECONDS, toacsGroups } from '../../../server/exams';
import '../../../styles/practice.css';

const groups = toacsGroups();
const error = Astro.url.searchParams.get('error')?.slice(0, 120);
const STEPS = [
  ['Eye', 'Look', 'One image per station, on a dark lightbox. Zoom with a double-click.'],
  ['PenLine', 'Answer', 'Type your findings in a private box. Nothing you type is stored.'],
  ['ScanEye', 'Reveal', 'The verbatim source caption, plus the facts from the same page with their status.'],
  ['ListChecks', 'Grade', 'Got it, partly or missed. Partly scores half. Missed ones can be repeated.'],
];
---
<App title="TOACS stations" crumbs={[{ label: 'Practice', href: '/practice' }]}>
  <header class="reveal" style="--i:0">
    <h1 class="text-2xl font-medium">TOACS stations</h1>
    <p class="mt-1 max-w-2xl text-muted">Timed image stations from the TOACS papers and slides. Model answers come only from the source captions and the facts on the same page, each with its status; Lightbox adds no diagnosis.</p>
  </header>
  {error && <p class="mt-4 flex items-center gap-2 rounded-xl border border-signal/30 bg-signal/10 px-4 py-3 text-sm" role="alert"><Icon name="Info" size={16} class="text-signal" />{error}</p>}

  <div class="setup mt-6">
    <form method="post" action="/api/toacs" class="panel reveal p-5 sm:p-6" style="--i:1" data-toacs>
      <fieldset>
        <legend class="text-sm font-medium">Source</legend>
        <div class="mt-3 flex flex-wrap gap-2">
          <label class="pick"><input type="radio" name="group" value="" checked data-n={images.length} /><span>All sources <span class="num text-xs text-muted">{images.length}</span></span></label>
          {groups.map((g) => <label class="pick"><input type="radio" name="group" value={g.group} data-n={g.n} /><span>{g.group} <span class="num text-xs text-muted">{g.n}</span></span></label>)}
        </div>
      </fieldset>

      <div class="divider my-5"></div>
      <label for="ts-count" class="flex items-baseline justify-between text-sm font-medium"><span>Stations</span><output for="ts-count" class="num text-2xl font-normal" data-out>10</output></label>
      <input id="ts-count" name="count" type="range" min="5" max="30" value="10" class="mt-2 w-full" data-count />
      <p class="mt-1 flex justify-between text-xs text-muted"><span class="num">5</span><span class="num" data-max>30</span></p>

      <div class="divider my-5"></div>
      <fieldset>
        <legend class="text-sm font-medium">Seconds per station</legend>
        <div class="seg mt-3 grid w-full grid-cols-4">
          {TOACS_SECONDS.map((s) => <label class="segpick"><input type="radio" name="seconds" value={s} checked={s === 60} /><span class="num">{s} s</span></label>)}
        </div>
      </fieldset>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <button class="btn btn-primary magnetic"><Icon name="Play" size={16} />Start stations</button>
        <span class="text-sm text-muted" data-total>About 10 minutes</span>
      </div>
    </form>

    <section class="panel reveal p-5 sm:p-6" style="--i:2" aria-labelledby="h-how">
      <h2 id="h-how" class="text-sm font-medium">How a station works</h2>
      <ol class="mt-4 space-y-4">
        {STEPS.map(([icon, title, text], k) => (
          <li class="step" style={`--i:${k}`}>
            <span class="step-ic"><Icon name={icon} size={17} /></span>
            <span><span class="block font-medium">{k + 1}. {title}</span><span class="block text-sm text-muted">{text}</span></span>
          </li>
        ))}
      </ol>
      <p class="mt-5 flex gap-2 rounded-lg bg-sunk px-3 py-2.5 text-xs text-muted"><Icon name="ShieldCheck" size={15} class="mt-px shrink-0 text-accent" />If a page has no facts, the station says so and you compare with the caption only.</p>
    </section>
  </div>
</App>

<script>
  import { magnetic } from '../../../scripts/motion';
  function init() {
    const form = document.querySelector<HTMLFormElement>('[data-toacs]');
    if (!form) return;
    magnetic(form);
    const range = form.querySelector<HTMLInputElement>('[data-count]')!;
    const sync = () => {
      const n = Number(form.querySelector<HTMLInputElement>('[name=group]:checked')?.dataset.n || 30);
      range.max = String(Math.max(5, Math.min(30, n)));
      if (Number(range.value) > Number(range.max)) range.value = range.max;
      form.querySelector('[data-out]')!.textContent = range.value;
      form.querySelector('[data-max]')!.textContent = range.max;
      const secs = Number(form.querySelector<HTMLInputElement>('[name=seconds]:checked')?.value || 60);
      const min = Math.round((Number(range.value) * (secs + 20)) / 60);
      form.querySelector('[data-total]')!.textContent = `About ${min} minute${min === 1 ? '' : 's'}`;
    };
    form.addEventListener('input', sync);
    sync();
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>

<style>
  .setup { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
  .pick { position: relative; cursor: pointer; }
  .pick input, .segpick input { position: absolute; opacity: 0; pointer-events: none; }
  .pick > span { display: inline-flex; align-items: center; gap: 0.4rem; height: 2.1rem; padding: 0 0.85rem; border-radius: 99px; border: 1px solid var(--line); font-size: 0.875rem; color: var(--muted); transition: all var(--d1); }
  .pick:hover > span { color: var(--ink); border-color: var(--line-strong); }
  .pick input:checked + span { color: var(--ink); border-color: var(--accent); background: var(--glow); }
  .pick input:focus-visible + span, .segpick input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .segpick { position: relative; cursor: pointer; }
  .segpick > span { display: grid; place-items: center; height: 2.1rem; border-radius: 8px; font-size: 0.8125rem; color: var(--muted); transition: color var(--d1), background-color var(--d2) var(--ease); }
  .segpick:hover > span { color: var(--ink); }
  .segpick input:checked + span { background: var(--raised); color: var(--ink); box-shadow: 0 1px 0 var(--line-strong), 0 2px 8px -4px rgb(0 0 0 / 0.4); }
  .step { display: flex; gap: 0.85rem; }
  .step-ic { display: grid; place-items: center; flex: none; width: 2.2rem; height: 2.2rem; border-radius: 10px; color: var(--accent); background: var(--glow); border: 1px solid color-mix(in oklab, var(--accent) 25%, transparent); }
  @media (max-width: 900px) { .setup { grid-template-columns: minmax(0, 1fr); } }
</style>
