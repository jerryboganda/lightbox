---
import App from '../../layouts/App.astro';
import McqPlayer from '../../components/islands/McqPlayer';
---
<App title="MCQs" crumbs={[{ label: 'Practice', href: '/practice' }]}>
  <McqPlayer client:load />
</App>
<style is:global>
  .opt { display: flex; align-items: center; gap: 0.85rem; width: 100%; padding: 0.8rem 0.95rem; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); font-size: 0.95rem; transition: border-color var(--d1), background-color var(--d2), opacity var(--d2), transform var(--d1) var(--ease); }
  .opt:not(:disabled):hover { border-color: var(--line-strong); background: color-mix(in oklab, var(--ink) 3%, var(--panel)); }
  .opt:not(:disabled):active { transform: scale(calc(1 - 0.01 * var(--move))); }
  .opt-key { display: grid; place-items: center; flex: none; width: 1.9rem; height: 1.9rem; border-radius: 8px; border: 1px solid var(--line-strong); font-size: 0.8125rem; color: var(--muted); transition: all var(--d2); }
  .opt-picked { border-color: var(--accent); background: var(--glow); }
  .opt-picked .opt-key { background: var(--accent); color: var(--accent-ink); border-color: transparent; }
  .opt-right { border-color: color-mix(in oklab, var(--ok) 60%, transparent); background: color-mix(in oklab, var(--ok) 12%, var(--panel)); }
  .opt-right .opt-key { background: var(--ok); color: var(--bg); border-color: transparent; }
  .opt-wrong { border-color: color-mix(in oklab, var(--bad) 60%, transparent); background: color-mix(in oklab, var(--bad) 10%, var(--panel)); }
  .opt-wrong .opt-key { background: var(--bad); color: var(--bg); border-color: transparent; }
  .opt-model { border-style: dashed; border-color: var(--line-strong); }
  .opt-dim { opacity: 0.5; }
</style>
