---
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import { images, mcqs, stats } from '../../lib/data';
import { dashboard } from '../../server/progress';
import { examHref, pool, recent, toacsGroups } from '../../server/exams';
import { when } from '../../lib/quiz';
const uid = Astro.locals.user!.id;
const d = dashboard(uid);
const keyed = mcqs.filter((m) => m.key).length;
const sessions = recent(uid);
const systems = new Set(pool.map((p) => p.system)).size;
const KIND = { quiz: ['ListChecks', 'Practice'], exam: ['Timer', 'Exam'], toacs: ['ScanEye', 'TOACS'] } as const;
const C = 2 * Math.PI * 15;
---
<App title="Practice">
  <header class="reveal" style="--i:0">
    <h1 class="text-2xl font-medium">Practice</h1>
    <p class="mt-1 text-muted">Spaced flashcards for retention, past-paper MCQs for exam timing, TOACS stations for image recall.</p>
  </header>
  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    <a href="/practice/cards" class="mode panel lift press reveal group" style="--i:1">
      <div class="mode-art" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="relative">
        <h2 class="text-lg font-medium">Flashcards</h2>
        <p class="mt-1 max-w-sm text-sm text-muted">{stats.anki} cards from verified facts, scheduled by FSRS so you review just before you forget.</p>
        <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm"><span><span class="num text-xl text-accent">{d.dueNow}</span> <span class="text-muted">due</span></span><span><span class="num text-xl">{d.newToday}</span> <span class="text-muted">new today</span></span><span><span class="num text-xl">{d.cardsSeen}</span> <span class="text-muted">started</span></span></p>
        <span class="btn btn-primary mt-5">{d.dueNow + d.newToday ? 'Start session' : 'Study ahead'}<Icon name="ArrowRight" size={16} /></span>
      </div>
    </a>
    <a href="/practice/mcq" class="mode panel lift press reveal group" style="--i:2">
      <div class="mode-art mcq" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span></div>
      <div class="relative">
        <h2 class="text-lg font-medium">Past-paper MCQs</h2>
        <p class="mt-1 max-w-sm text-sm text-muted">{mcqs.length} IMM questions. {keyed} have an answer key; disputed ones show the evidence for both sides.</p>
        <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm"><span><span class="num text-xl">{d.mcqAnswered}</span> <span class="text-muted">answered</span></span><span><span class="num text-xl">{d.mcqKeyed ? Math.round((d.mcqRight / d.mcqKeyed) * 100) + '%' : '–'}</span> <span class="text-muted">correct</span></span></p>
        <span class="btn mt-5">Open the bank<Icon name="ArrowRight" size={16} /></span>
      </div>
    </a>
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-3">
    <a href="/practice/builder" class="mode small panel lift press reveal group" style="--i:3">
      <div class="art-sliders" aria-hidden="true"><span style="--a:62%;--b:30%"></span><span style="--a:28%;--b:74%"></span><span style="--a:80%;--b:46%"></span></div>
      <div class="relative">
        <h2 class="font-medium">Custom quiz</h2>
        <p class="mt-1 text-sm text-muted">Filter by paper, system, key status and your misses. Instant feedback.</p>
        <p class="mt-3 text-sm"><span class="num text-ink">{pool.length}</span> <span class="text-muted">questions across</span> <span class="num text-ink">{systems}</span> <span class="text-muted">systems</span></p>
        <span class="mode-cta">Build a quiz<Icon name="ArrowRight" size={15} /></span>
      </div>
    </a>
    <a href="/practice/builder?mode=exam" class="mode small panel lift press reveal group" style="--i:4">
      <svg class="art-watch" viewBox="0 0 44 44" aria-hidden="true">
        <circle cx="22" cy="24" r="15" fill="none" stroke="var(--line-strong)" stroke-width="3" />
        <circle cx="22" cy="24" r="15" fill="none" stroke="var(--signal)" stroke-width="3" stroke-linecap="round" stroke-dasharray={C} style={`--c:${C}`} class="sweep" transform="rotate(-90 22 24)" />
        <path d="M22 24V16" stroke="var(--ink)" stroke-width="2.4" stroke-linecap="round" class="hand" />
        <path d="M18 5h8M22 5v4" stroke="var(--line-strong)" stroke-width="2.4" stroke-linecap="round" />
      </svg>
      <div class="relative">
        <h2 class="font-medium">Timed exam</h2>
        <p class="mt-1 text-sm text-muted">Full papers or a quick ten, against the clock. Feedback comes at the end.</p>
        <p class="mt-3 text-sm"><span class="text-muted">Autosaves, resumes after a reload</span></p>
        <span class="mode-cta">Start an exam<Icon name="ArrowRight" size={15} /></span>
      </div>
    </a>
    <a href="/practice/toacs" class="mode small panel lift press reveal group" style="--i:5">
      <div class="art-box" aria-hidden="true"><span class="scan"></span><i></i><i></i><i></i></div>
      <div class="relative">
        <h2 class="font-medium">TOACS stations</h2>
        <p class="mt-1 text-sm text-muted">Timed image stations, then the source caption and the facts from that page.</p>
        <p class="mt-3 text-sm"><span class="num text-ink">{images.length}</span> <span class="text-muted">images from</span> <span class="num text-ink">{toacsGroups().length}</span> <span class="text-muted">sources</span></p>
        <span class="mode-cta">Run stations<Icon name="ArrowRight" size={15} /></span>
      </div>
    </a>
  </div>

  <section class="panel reveal mt-6 p-5" style="--i:6" aria-labelledby="h-recent">
    <header class="flex items-center justify-between gap-3"><h2 id="h-recent" class="text-[0.95rem] font-medium">Recent sessions</h2>{sessions.length > 0 && <span class="text-xs text-muted">last {sessions.length}</span>}</header>
    {sessions.length === 0 ? (
      <p class="mt-3 flex items-center gap-3 text-sm text-muted"><Icon name="History" size={18} class="shrink-0 text-faint" />No sessions yet. Quizzes, exams and TOACS runs land here, with their scores and a resume button.</p>
    ) : (
      <ul class="mt-2 divide-y divide-line">
        {sessions.map((s) => {
          const pct = s.finished_at && s.total ? Math.round(((s.score ?? 0) / s.total) * 100) : null;
          const open = !s.finished_at && !s.expired;
          return (
            <li>
              <a href={examHref(s)} class="srow group">
                <span class="sicon"><Icon name={KIND[s.mode][0]} size={17} /></span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm group-hover:text-accent">{s.title}</span>
                  <span class="block truncate text-xs text-muted">{KIND[s.mode][1]} · {when(s.started_at)} · <span class="num">{s.answered}/{s.n}</span> {s.mode === 'toacs' ? 'graded' : 'answered'}</span>
                </span>
                {open ? <span class="btn btn-sm">Resume<Icon name="Play" size={13} /></span>
                  : s.expired ? <span class="badge s-unchecked">Time up · see results</span>
                  : pct !== null ? <span class="flex items-center gap-2"><svg width="30" height="30" viewBox="0 0 36 36" class="-rotate-90" aria-hidden="true"><circle cx="18" cy="18" r="15" fill="none" stroke="var(--line)" stroke-width="4" /><circle cx="18" cy="18" r="15" fill="none" stroke={pct >= 70 ? 'var(--ok)' : pct >= 50 ? 'var(--accent)' : 'var(--signal)'} stroke-width="4" stroke-linecap="round" stroke-dasharray={C} stroke-dashoffset={C * (1 - pct / 100)} /></svg><span class="num w-10 text-right text-sm">{pct}%</span></span>
                  : <span class="text-xs text-muted">Unscored</span>}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</App>
<style>
  .mode { position: relative; overflow: hidden; padding: 1.5rem; min-height: 15rem; }
  .mode.small { padding: 1.25rem 1.35rem; }
  .mode-art { position: absolute; right: -1rem; top: 50%; translate: 0 -50%; width: 11rem; height: 9rem; pointer-events: none; }
  .mode-art span { position: absolute; inset: 0; border-radius: 16px; border: 1px solid var(--line-strong); background: var(--raised); transition: transform var(--d3) var(--ease); }
  .mode-art span:nth-child(1) { transform: rotate(-9deg) translate(-1.2rem, 0.4rem); opacity: 0.45; }
  .mode-art span:nth-child(2) { transform: rotate(-3deg) translate(-0.4rem, 0.1rem); opacity: 0.7; }
  .mode-art span:nth-child(3) { transform: rotate(4deg); border-color: color-mix(in oklab, var(--accent) 45%, transparent); }
  .mode:hover .mode-art span:nth-child(1) { transform: rotate(-14deg) translate(-2.2rem, 0.6rem); }
  .mode:hover .mode-art span:nth-child(3) { transform: rotate(8deg) translate(0.4rem, -0.2rem); }
  .mode-art.mcq { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; width: 9rem; height: auto; right: 1rem; opacity: 0.8; }
  .mode-art.mcq span { position: static; display: grid; place-items: center; height: 3rem; font-family: var(--font-mono); color: var(--faint); transform: none; opacity: 1; }
  .mode-art.mcq span:nth-child(3) { color: var(--accent); background: var(--glow); }
  .mode:hover .mode-art.mcq span:nth-child(3) { transform: scale(1.06); }
  .mode-cta { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem; font-size: 0.875rem; font-weight: 500; color: var(--accent); }
  .mode-cta :global(svg) { transition: transform var(--d2) var(--ease); }
  .mode:hover .mode-cta :global(svg) { transform: translateX(calc(3px * var(--move))); }

  /* Small cards: the art is an in-flow emblem above the title, so copy never runs under it. */
  .mode.small { min-height: 0; display: flex; flex-direction: column; }
  .mode.small .relative { flex: 1; display: flex; flex-direction: column; margin-top: 1rem; }
  .mode.small .mode-cta { margin-top: auto; padding-top: 1rem; align-self: flex-start; }
  .art-sliders, .art-watch, .art-box { position: relative; height: 3rem; pointer-events: none; }
  .art-sliders { width: 3.6rem; display: grid; align-content: center; gap: 0.55rem; }
  .art-sliders span { position: relative; height: 3px; border-radius: 99px; background: var(--line-strong); }
  .art-sliders span::after { content: ""; position: absolute; top: 50%; left: var(--a); width: 0.7rem; height: 0.7rem; translate: -50% -50%; border-radius: 99px; background: var(--raised); border: 2px solid var(--accent); transition: left var(--d4) var(--ease); }
  .mode:hover .art-sliders span::after { left: var(--b); }
  .art-watch { width: 3rem; height: 3rem; }
  .sweep { stroke-dashoffset: calc(var(--c) * 0.3); transition: stroke-dashoffset 1.1s var(--ease); }
  .mode:hover .sweep { stroke-dashoffset: calc(var(--c) * 0.92); }
  .hand { transform-origin: 22px 24px; transform: rotate(108deg); transition: transform 1.1s var(--ease); }
  .mode:hover .hand { transform: rotate(calc(108deg + 252deg * var(--move))); }
  .art-box { width: 3.75rem; height: 3rem; border-radius: 9px; background: #05070a; border: 1px solid var(--line-strong); overflow: hidden; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; padding: 6px; }
  .art-box i { border-radius: 3px; background: linear-gradient(160deg, #2a3644, #121a23); }
  .art-box i:nth-of-type(2) { background: linear-gradient(160deg, #3b4b5c, #16202b); }
  .art-box .scan { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--accent); box-shadow: 0 0 10px var(--accent); opacity: 0; }
  .mode:hover .art-box .scan { animation: boxscan 1.4s var(--ease) infinite; }
  @keyframes boxscan { 0% { opacity: 0; transform: translateY(0); } 15% { opacity: 1; } 100% { opacity: 0; transform: translateY(2.8rem); } }

  .srow { display: flex; align-items: center; gap: 0.85rem; padding: 0.7rem 0.25rem; border-radius: 10px; transition: background-color var(--d1); }
  .srow:hover { background: color-mix(in oklab, var(--ink) 4%, transparent); }
  .sicon { display: grid; place-items: center; flex: none; width: 2.1rem; height: 2.1rem; border-radius: 9px; color: var(--accent); background: var(--glow); }
  @media (max-width: 640px) { .mode-art, .mode-art.mcq { display: none; } }
  @media (min-width: 641px) { .mode:not(.small) > .relative { padding-right: 10.5rem; } } /* copy stays clear of the art */
  @media (prefers-reduced-motion: reduce) { .mode:hover .art-box .scan { animation: none; } }
  :global([data-motion="reduced"]) .mode:hover .art-box .scan { animation: none; }
</style>
