---
// Today's three goals as rings. Same numbers the StudyTimer panel shows (GET /api/goals).
import Icon from '../Icon.astro';
interface Props { done: { cards: number; mcqs: number; minutes: number }; goals: { cards: number; mcqs: number; minutes: number } }
const { done, goals } = Astro.props;
const R = 23, C = 2 * Math.PI * R;
const rings = [
  { key: 'cards', label: 'Cards reviewed', unit: '', c: 'var(--ok)' },
  { key: 'mcqs', label: 'MCQs answered', unit: '', c: 'var(--signal)' },
  { key: 'minutes', label: 'Focus time', unit: 'm', c: 'var(--accent)' },
] as const;
---
<ul class="gr">
  {rings.map((g, i) => {
    const d = done[g.key], goal = goals[g.key], p = goal ? Math.min(1, d / goal) : 0, met = goal > 0 && d >= goal;
    return (
      <li class="gr-item">
        <span class="gr-ring" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 56 56" class="-rotate-90" aria-hidden="true">
            <circle cx="28" cy="28" r={R} fill="none" stroke="var(--sunk)" stroke-width="6" />
            <circle cx="28" cy="28" r={R} fill="none" stroke={g.c} stroke-width="6" stroke-linecap="round" stroke-dasharray={C} style={`--off:${C * (1 - p)};--full:${C};--i:${i}`} class="gr-arc" />
          </svg>
          <span class="gr-in" style={`color:${g.c}`}>{met ? <Icon name="Check" size={20} stroke-width={2.5} /> : <span class="num text-ink text-sm">{goal ? `${Math.round(p * 100)}%` : '–'}</span>}</span>
        </span>
        <span class="min-w-0">
          <span class="block text-sm"><span class="num text-ink">{d}{g.unit}</span><span class="text-muted"> / <span class="num">{goal}{g.unit}</span></span></span>
          <span class="block text-xs text-muted">{g.label}{met && <span class="sr-only">, goal met</span>}{!goal && <span class="sr-only">, no goal set</span>}</span>
        </span>
      </li>
    );
  })}
</ul>

<style>
  .gr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .gr-item { display: flex; align-items: center; gap: 0.65rem; min-width: 0; }
  .gr-ring { position: relative; flex: none; width: 56px; height: 56px; }
  .gr-in { position: absolute; inset: 0; display: grid; place-items: center; }
  .gr-arc { stroke-dashoffset: var(--off); animation: gr-ring calc(1.1s * var(--move)) var(--ease) both; animation-delay: calc(var(--i) * 120ms + 250ms); }
  @keyframes gr-ring { from { stroke-dashoffset: var(--full); } }
  @media (max-width: 40rem) { .gr { gap: 0.5rem; } .gr-item { flex-direction: column; text-align: center; gap: 0.5rem; } }
</style>
