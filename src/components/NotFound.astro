---
import Icon from './Icon.astro';
interface Props { what: string; back: string; backLabel: string }
const { what, back, backLabel } = Astro.props;
---
<section class="reveal mx-auto grid max-w-md place-items-center gap-3 py-20 text-center" style="--i:0">
  <span class="grid h-14 w-14 place-items-center rounded-2xl bg-signal/10 text-signal"><Icon name="FileQuestion" size={26} /></span>
  <p class="num text-xs tracking-widest text-faint">404</p>
  <h1 class="text-2xl font-medium">{what} not found</h1>
  <p class="text-muted">The link may be mistyped, or the item was renamed when the study data was rebuilt.</p>
  <div class="mt-3 flex flex-wrap justify-center gap-2">
    <a href={back} class="btn btn-primary"><Icon name="ArrowLeft" size={16} />{backLabel}</a>
    <button type="button" class="btn" data-open-palette><Icon name="Search" size={16} />Search</button>
  </div>
</section>
