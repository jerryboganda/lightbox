# First admin, created once when the database is empty. They must change the password at first sign-in.
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_INITIAL_PASSWORD=

# Local development only (Docker sets /data/lightbox.db).
DB_PATH=./data/lightbox.db

# Phase 3 AI features (OpenCode Go gateway). Keep the key only here, never in the repository.
OPENCODE_API_KEY=
AI_MODEL=deepseek-v4-flash
