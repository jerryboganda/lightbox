# First admin, created once when the database is empty. They must change the password at first sign-in.
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_INITIAL_PASSWORD=

# Local development only (Docker sets /data/lightbox.db).
DB_PATH=./data/lightbox.db

# Phase 3 AI features (OpenCode Go gateway). Keep the key only here, never in the repository.
# Without a key the AI features show "AI is not configured on this server" and everything else works.
OPENCODE_API_KEY=
AI_MODEL=deepseek-v4.1-flash
# Thinking effort sent to the gateway as reasoning_effort; thinking tokens share max_tokens. Empty omits the hint.
AI_REASONING=max
# Requests per member per day (Pakistan time); admins get three times this.
AI_DAILY_CAP=30
# Optional paid fallback, used only when Go fails with a 5xx or times out: set AI_FALLBACK=zen and a Zen model.
AI_FALLBACK=
AI_FALLBACK_MODEL=
# Tests only: point the gateway at a local mock (default https://opencode.ai/zen/go/v1).
# AI_BASE_URL=
